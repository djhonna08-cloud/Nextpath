NVIDIA_API_KEY=replace-with-your-new-nvidia-api-key
NVIDIA_MODEL=z-ai/glm-5.3-flash

# XAMPP MySQL/MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nextpath

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASS=replace-with-a-new-gmail-app-password
SMTP_FROM="NextPath <yourname@gmail.com>"

# Optional: used only by `npm run create-admin`; rotate and remove after bootstrapping.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
