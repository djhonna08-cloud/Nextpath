.main-content:not(:has(.explorer-page)) .course-match-summary[data-category="education"] { --card-accent: var(--category-green); --card-pastel: var(--category-green-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-summary[data-category="arts-design-communication"] { --card-accent: var(--category-coral); --card-pastel: var(--category-coral-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-summary[data-category="science-environment"] { --card-accent: var(--category-teal); --card-pastel: var(--category-teal-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-summary[data-category="social-public-service"] { --card-accent: var(--category-indigo); --card-pastel: var(--category-indigo-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-results > .result-head[data-category="technology-computing"] { --card-accent: var(--category-blue); --card-pastel: var(--category-blue-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-results > .result-head[data-category="business-management"] { --card-accent: var(--category-orange); --card-pastel: var(--category-orange-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-results > .result-head[data-category="engineering-architecture"] { --card-accent: var(--category-purple); --card-pastel: var(--category-purple-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-results > .result-head[data-category="health-medical"] { --card-accent: var(--category-pink); --card-pastel: var(--category-pink-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-results > .result-head[data-category="education"] { --card-accent: var(--category-green); --card-pastel: var(--category-green-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-results > .result-head[data-category="arts-design-communication"] { --card-accent: var(--category-coral); --card-pastel: var(--category-coral-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-results > .result-head[data-category="science-environment"] { --card-accent: var(--category-teal); --card-pastel: var(--category-teal-pastel); }
