.main-content:not(:has(.explorer-page)) .course-match-explanations article[data-category="education"] { --card-accent: var(--category-green); --card-pastel: var(--category-green-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-explanations article[data-category="arts-design-communication"] { --card-accent: var(--category-coral); --card-pastel: var(--category-coral-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-explanations article[data-category="science-environment"] { --card-accent: var(--category-teal); --card-pastel: var(--category-teal-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-explanations article[data-category="social-public-service"] { --card-accent: var(--category-indigo); --card-pastel: var(--category-indigo-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-summary[data-category],
.main-content:not(:has(.explorer-page)) .course-match-results > .result-head[data-category],
.main-content:not(:has(.explorer-page)) .course-match-explanations article[data-category] {
  border: 1px solid rgba(126, 145, 190, .13);
  border-top: 8px solid var(--card-accent);
  border-radius: 13px;
  background: linear-gradient(145deg, var(--card-pastel) 0%, rgba(255, 255, 255, .98) 88%);
  box-shadow: 0 8px 20px rgba(74, 91, 145, .12);
}
.main-content:not(:has(.explorer-page)) .quiz-box:not(.course-match-results-chat) {
  --card-accent: var(--brand-purple);
  --card-pastel: #FBFAFF;
}
.main-content:not(:has(.explorer-page)) .answer {
  border-color: rgba(113, 127, 165, .2);
  border-top: 3px solid var(--category-blue);
  border-radius: 11px;
}
.main-content:not(:has(.explorer-page)) .answer:nth-child(4n + 2) { border-top-color: var(--category-purple); }
.main-content:not(:has(.explorer-page)) .answer:nth-child(4n + 3) { border-top-color: var(--category-pink); }
.main-content:not(:has(.explorer-page)) .answer:nth-child(4n + 4) { border-top-color: var(--category-orange); }
.main-content:not(:has(.explorer-page)) .answer.selected {
  border-color: var(--brand-purple);
  border-top-width: 3px;
}
.main-content:not(:has(.explorer-page)) .detail-hero .category,
.main-content:not(:has(.explorer-page)) .detail-hero h1 { color: #17213a; }
.main-content:not(:has(.explorer-page)) .detail-hero .category { color: var(--brand-purple); }
.main-content:not(:has(.explorer-page)) .match-card {
  border: 0 !important;
  border-radius: 13px !important;
  background: linear-gradient(120deg, #4361EE, #7C3AED) !important;
  color: #fff;
}
.main-content:not(:has(.explorer-page)) .match-card p { color: #eef0ff; }
.main-content:not(:has(.explorer-page)) .profile-message,
.main-content:not(:has(.explorer-page)) .toast {
  border: 1px solid rgba(124, 58, 237, .12);
  border-radius: 10px;
  background: linear-gradient(110deg, #F0EDFF, #FCEFF7);
  color: #3e367f;
}
.chat-panel {
  border-color: rgba(124, 58, 237, .16);
  border-radius: 15px;
  box-shadow: 0 15px 34px rgba(45, 50, 93, .2);
}
.chat-widget-header { background: #111827; }
.chat-message.assistant { background: #F3F0FF; }
.chat-message.user { background: #EAF2FF; }
.course-match-page .course-match-results-chat .chat-message.assistant { background: #F3F0FF; }
.course-match-page .course-match-results-chat .chat-message.user { background: #EAF2FF; }
.main-content:not(:has(.explorer-page)) .about-point {
  --card-accent: var(--category-blue);
  --card-pastel: #EFF6FF;
  border-radius: 12px;
  padding: 19px;
}
.main-content:not(:has(.explorer-page)) .about-point:nth-child(3n + 2) { --card-accent: var(--category-purple); --card-pastel: #F4F0FF; }
.main-content:not(:has(.explorer-page)) .about-point:nth-child(3n) { --card-accent: var(--category-pink); --card-pastel: #FFF0F7; }
.main-content:not(:has(.explorer-page)) .admin-inline-form,
.main-content:not(:has(.explorer-page)) .admin-course-form,
.main-content:not(:has(.explorer-page)) .admin-settings-form {
  border: 1px solid rgba(125, 139, 184, .2);
  border-radius: 12px;
  background: rgba(255, 255, 255, .78);
  box-shadow: 0 5px 16px rgba(67, 82, 145, .06);
}
.main-content:not(:has(.explorer-page)) .admin-users-table th { background: #F3F0FF; }
.main-content:not(:has(.explorer-page)) .admin-users-table tbody tr:nth-child(even) { background: rgba(255, 255, 255, .48); }
.auth-form {
  padding: clamp(24px, 4vw, 38px);
  border: 1px solid rgba(125, 139, 184, .16);
  border-radius: 16px;
  background: rgba(255, 255, 255, .92);
  box-shadow: var(--shared-card-shadow);
}
.auth-form .form-field input {
  border-color: rgba(125, 139, 184, .28);
  border-radius: 9px;
  box-shadow: 0 3px 10px rgba(74, 91, 145, .05);
}
.auth-form .form-field input:focus {
  border-color: var(--brand-purple);
  box-shadow: 0 0 0 3px rgba(124, 58, 237, .13);
}
.auth-form h2 { color: #17213a; }
.form-switch button { color: var(--brand-purple); }
@media (max-width: 600px) {
  .auth-form { padding: 24px 18px; }
  .main-content:not(:has(.explorer-page)) .stat-grid { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  .main-content:not(:has(.explorer-page)) *,
  .auth-wrap * {
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
    animation-duration: .01ms !important;
  }
}

.main-content:has(.course-match-page .course-match-results) {
  background: #F4F7FF;
}
.course-match-page .course-match-results-heading {
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 20px;
}
.course-match-page .course-match-results-heading > div { max-width: 820px; }
.course-match-page .course-match-results-heading .eyebrow {
  color: #4F46E5;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
}
.course-match-page .course-match-results-heading h1 {
  margin: 7px 0 8px;
  color: #14213D;
  font-size: clamp(32px, 4vw, 42px);
  line-height: 1.12;
}
.course-match-page .course-match-results-heading h1 .gradient-heading-text {
  background: linear-gradient(100deg, #4F46E5, #6D5DFB);
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.course-match-page .course-match-results-heading p {
  max-width: 760px;
  margin: 0;
  color: #53617D;
  font-size: 14px;
  line-height: 1.55;
}
.course-match-page .retake-course-match-button {
  flex: 0 0 auto;
  min-height: 42px;
  margin-top: 2px;
  padding: 10px 15px;
  border: 1px solid #D7DFF0;
  border-radius: 9px;
  background: #fff;
  color: #263654;
  font-size: 12px;
  font-weight: 700;
}
.course-match-page .course-match-results { max-width: none; }
.course-match-page .course-match-results .result-card-list { display: block; }
.course-match-page .best-match-list { margin-bottom: 22px; }
.course-match-page .result-card.course-match-result-card {
  --match-accent: #4F46E5;
  display: block;
  min-width: 0;
  margin: 0;
  border: 1px solid #E1E7F2;
  border-radius: 15px;
  background: #fff;
  box-shadow: 0 7px 22px rgba(37, 56, 100, .07);
}
.course-match-page .result-card.course-match-result-card[data-match-rank="2"] { --match-accent: #2563EB; }
.course-match-page .result-card.course-match-result-card[data-match-rank="3"] { --match-accent: #DB2777; }
.course-match-page .result-card.course-match-result-card h2,
.course-match-page .result-card.course-match-result-card h3 {
  color: #14213D;
}
.course-match-page .best-match-card {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) 215px;
  gap: 24px;
  padding: 26px;
}
.course-match-page .best-match-content { min-width: 0; }
.course-match-page .recommendation-rank {
  display: inline-flex;
  align-items: center;
  min-height: 25px;
  padding: 4px 11px;
  border-radius: 999px;
  background: #EEF2FF;
  color: #4F46E5;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.course-match-page .best-match-content h2 {
  margin: 10px 0 4px;
  font-size: clamp(22px, 2.4vw, 29px);
  line-height: 1.2;
}
.course-match-page .best-match-score {
  margin: 0 0 12px;
  color: #33415E;
  font-size: 13px;
  font-weight: 700;
}
.course-match-page .best-match-score span {
  color: #66738E;
  font-weight: 400;
}
.course-match-page .compatibility-progress {
  width: 100%;
  height: 9px;
  overflow: hidden;
  border-radius: 99px;
  background: #E8ECF4;
}
.course-match-page .compatibility-progress span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: var(--match-accent);
}
.course-match-page .personalized-match-reason {
  margin: 14px 0 12px;
  color: #45536F;
  font-size: 13px;
  line-height: 1.55;
}
.course-match-page .personalized-match-reason strong,
.course-match-page .matching-evidence > strong {
  color: #14213D;
  font-size: 13px;
}
.course-match-page .matching-evidence { margin: 12px 0 0; }
.course-match-page .matching-evidence > strong { margin-bottom: 7px; }
.course-match-page .match-evidence-tags { gap: 7px; }
.course-match-page .match-evidence-tags span {
  padding: 5px 10px;
  border: 1px solid #E0E7FF;
  border-radius: 999px;
  background: #F2F4FF;
  color: #414F83;
  font-size: 11px;
}
.course-match-page .best-match-score-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 10px;
  padding: 6px 0 6px 23px;
  border-left: 1px solid #E2E7F0;
  text-align: center;
}
.course-match-page .score-panel-label {
  color: #65728B;
  font-size: 11px;
  font-weight: 700;
}
.course-match-page .best-match-percentage {
  color: #4F46E5;
  font-size: clamp(44px, 5vw, 60px);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -.05em;
}
.course-match-page .compatibility-strength {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 26px;
  padding: 5px 10px;
  border: 1px solid #E0E7FF;
  border-radius: 999px;
  background: #F1F3FF;
  color: #4542A1;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
}
.course-match-page .best-match-score-panel .primary-btn {
  width: 100%;
  min-height: 42px;
  margin-top: 7px;
  padding: 10px 12px;
  border: 0;
  border-radius: 9px;
  background: #4F46E5;
  box-shadow: none;
  font-size: 12px;
}
.course-match-page .best-match-score-panel .primary-btn:hover { background: #4338CA; }
.course-match-page .other-course-results { margin-top: 0; }
.course-match-page .other-courses-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}
.course-match-page .other-courses-heading h2 {
  margin: 0;
  color: #14213D;
  font-size: 19px;
}
.course-match-page .other-courses-heading p {
  margin: 0;
  color: #66738E;
  font-size: 12px;
}
.course-match-page .other-course-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}
.course-match-page .supporting-match-card { padding: 18px; }
.course-match-page .supporting-card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px;
}
.course-match-page .supporting-card-heading h3 {
  margin: 0;
  font-size: 16px;
  line-height: 1.35;
}
.course-match-page .supporting-score {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 7px;
}
.course-match-page .supporting-score > strong {
  color: var(--match-accent);
  font-size: 20px;
  line-height: 1;
}
.course-match-page .supporting-match-card .compatibility-strength {
  border-color: color-mix(in srgb, var(--match-accent), white 78%);
  background: color-mix(in srgb, var(--match-accent), white 93%);
  color: color-mix(in srgb, var(--match-accent), #14213D 18%);
  font-size: 10px;
}
.course-match-page .supporting-match-card .personalized-match-reason {
  margin: 12px 0 10px;
  font-size: 12px;
  line-height: 1.48;
}
.course-match-page .supporting-match-card .matching-evidence { margin-top: 10px; }
.course-match-page .supporting-match-card .match-evidence-tags span {
  border-color: color-mix(in srgb, var(--match-accent), white 82%);
  background: color-mix(in srgb, var(--match-accent), white 94%);
  color: color-mix(in srgb, var(--match-accent), #14213D 20%);
}
.course-match-page .course-detail-button {
  width: 100%;
  min-height: 36px;
  margin-top: 12px;
  padding: 8px 12px;
  border: 1px solid color-mix(in srgb, var(--match-accent), white 65%);
  border-radius: 8px;
  background: #fff;
  color: var(--match-accent);
  font-size: 12px;
  font-weight: 700;
}
.course-match-page .course-detail-button:hover {
  background: color-mix(in srgb, var(--match-accent), white 94%);
}
.course-match-page .compatibility-note {
  margin: 15px 0 0;
  padding: 10px 12px;
  border: 1px solid #E1E7F2;
  border-radius: 9px;
  background: #fff;
  color: #53617D;
  font-size: 11px;
}
.course-match-page .compatibility-note summary {
  color: #4F46E5;
  cursor: pointer;
  font-weight: 700;
}
.course-match-page .compatibility-note p { line-height: 1.6; }
.course-match-page .compatibility-note .match-factor-scores {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}
.course-match-page .course-match-results-chat {
  display: grid;
  grid-template-columns: minmax(220px, .85fr) minmax(0, 1.35fr);
  align-items: center;
  gap: 12px 20px;
  max-width: none;
  margin-top: 18px;
  padding: 17px 19px;
  border: 1px solid #E1E7F2;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 6px 20px rgba(37, 56, 100, .06);
}
.course-match-page .course-match-results-chat .results-chat-heading {
  grid-column: 1;
  grid-row: 1;
  padding: 0;
  border: 0;
  background: transparent;
}
.course-match-page .results-chat-heading .eyebrow {
  margin: 0;
  color: #4F46E5;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.course-match-page .results-chat-heading h2 {
  margin: 5px 0;
  color: #14213D;
  font-size: 17px;
}
.course-match-page .results-chat-heading p {
  margin: 0;
  color: #65728B;
  font-size: 11px;
  line-height: 1.45;
}
.course-match-page .course-match-results-chat .chat-form {
  grid-column: 2;
  grid-row: 1;
  align-items: stretch;
  gap: 9px;
  margin: 0;
  padding: 0;
}
.course-match-page .course-match-results-chat .chat-form textarea {
  min-height: 46px;
  max-height: 110px;
  padding: 12px 13px;
  border: 1px solid #E0E6F0;
  border-radius: 9px;
  background: #fff;
  color: #14213D;
  font-size: 12px;
}
.course-match-page .course-match-results-chat .chat-form .primary-btn {
  min-width: 82px;
  min-height: 46px;
  border-radius: 9px;
  background: #4F46E5;
  box-shadow: none;
  font-size: 12px;
}
.course-match-page .course-match-results-chat .chat-form .primary-btn:hover { background: #4338CA; }
.course-match-page .course-match-results-chat .chat-messages {
  grid-column: 1 / -1;
  grid-row: 2;
  min-height: 0;
  max-height: 190px;
  padding: 0;
}
.course-match-page .course-match-results-chat .chat-notice {
  grid-column: 1 / -1;
  grid-row: 3;
  margin: 0;
  padding: 0;
  color: #7A879D;
  font-size: 10px;
}
.course-match-page .course-match-results-chat .chat-error {
  grid-column: 1 / -1;
  margin: 0;
}
@media (max-width: 900px) {
  .course-match-page .best-match-card { grid-template-columns: minmax(0, 1fr) 180px; }
  .course-match-page .supporting-card-heading { flex-direction: column; }
  .course-match-page .course-match-results-chat { grid-template-columns: minmax(180px, .8fr) minmax(0, 1.2fr); }
}
@media (max-width: 650px) {
  .course-match-page .course-match-results-heading {
    flex-direction: column;
    gap: 12px;
  }
  .course-match-page .course-match-results-heading h1 { font-size: clamp(28px, 8vw, 36px); }
  .course-match-page .retake-course-match-button { align-self: flex-start; }
  .course-match-page .best-match-card {
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    padding: 19px;
  }
  .course-match-page .best-match-score-panel {
    align-items: flex-start;
    padding: 14px 0 0;
    border-top: 1px solid #E2E7F0;
    border-left: 0;
    text-align: left;
  }
  .course-match-page .best-match-score-panel .primary-btn { max-width: 260px; }
  .course-match-page .other-course-grid { grid-template-columns: minmax(0, 1fr); }
  .course-match-page .supporting-card-heading { flex-direction: row; }
  .course-match-page .other-courses-heading { align-items: flex-start; flex-direction: column; gap: 4px; }
  .course-match-page .course-match-results-chat {
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    padding: 16px;
  }
  .course-match-page .course-match-results-chat .results-chat-heading,
  .course-match-page .course-match-results-chat .chat-form,
  .course-match-page .course-match-results-chat .chat-messages,
  .course-match-page .course-match-results-chat .chat-notice {
    grid-column: 1;
    grid-row: auto;
  }
  .course-match-page .course-match-results-chat .chat-form {
    align-items: stretch;
    flex-direction: column;
  }
  .course-match-page .course-match-results-chat .chat-form .primary-btn { min-height: 44px; }
  .course-match-page .compatibility-note .match-factor-scores { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

/* Use the category-card visual system for every dynamically rendered course card. */
.explorer-page .course-card {
  --card-accent: var(--category-blue);
  --card-pastel: var(--category-blue-pastel);
  min-width: 0;
  border: 1px solid rgba(126, 145, 190, .13);
  border-top: 8px solid var(--card-accent);
  border-radius: 13px;
  background: linear-gradient(145deg, var(--card-pastel) 0%, rgba(255, 255, 255, .98) 88%);
  box-shadow: 0 8px 20px rgba(74, 91, 145, .12);
  transition: transform .2s ease, box-shadow .2s ease;
}
.explorer-page .course-card[data-category="technology-computing"] { --card-accent: var(--category-blue); --card-pastel: var(--category-blue-pastel); }
.explorer-page .course-card[data-category="business-management"] { --card-accent: var(--category-orange); --card-pastel: var(--category-orange-pastel); }
.explorer-page .course-card[data-category="engineering-architecture"] { --card-accent: var(--category-purple); --card-pastel: var(--category-purple-pastel); }
.explorer-page .course-card[data-category="health-medical"] { --card-accent: var(--category-pink); --card-pastel: var(--category-pink-pastel); }
.explorer-page .course-card[data-category="education"] { --card-accent: var(--category-green); --card-pastel: var(--category-green-pastel); }
.explorer-page .course-card[data-category="arts-design-communication"] { --card-accent: var(--category-coral); --card-pastel: var(--category-coral-pastel); }
.explorer-page .course-card[data-category="science-environment"] { --card-accent: var(--category-teal); --card-pastel: var(--category-teal-pastel); }
.explorer-page .course-card[data-category="social-public-service"] { --card-accent: var(--category-indigo); --card-pastel: var(--category-indigo-pastel); }
.explorer-page .course-card .course-color { display: none; }
.explorer-page .course-card[data-category="technology-computing"] .course-color,
.explorer-page .course-card[data-category="business-management"] .course-color,
.explorer-page .course-card[data-category="engineering-architecture"] .course-color,
.explorer-page .course-card[data-category="health-medical"] .course-color,
.explorer-page .course-card[data-category="education"] .course-color,
.explorer-page .course-card[data-category="arts-design-communication"] .course-color,
.explorer-page .course-card[data-category="science-environment"] .course-color,
.explorer-page .course-card[data-category="social-public-service"] .course-color { background: var(--card-accent); }
.explorer-page .course-card-body { background: transparent; }
.explorer-page .course-card h3 {
  color: #17213a;
  font-family: 'DM Sans', sans-serif;
  font-size: 20px;
  font-weight: 750;
  letter-spacing: -.45px;
}
.explorer-page .course-card p { color: #536789; }
.explorer-page .course-card .category,
.explorer-page .course-card .arrow { color: var(--card-accent); }
.explorer-page .course-card .pill {
  border: 1px solid color-mix(in srgb, var(--card-accent), white 82%);
  border-radius: 6px;
  background: color-mix(in srgb, var(--card-accent), white 92%);
  color: color-mix(in srgb, var(--card-accent), #17213a 22%);
}
.explorer-page .course-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 13px 25px rgba(74, 91, 145, .16);
}
.explorer-page .course-card:hover { border-top-color: var(--card-accent); }
.main-content:not(:has(.explorer-page)) .admin-stat {
  display: flex;
  min-height: 142px;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 5px;
  padding: 18px 20px;
  background: linear-gradient(145deg, var(--card-pastel) 0%, rgba(255, 255, 255, .98) 88%);
  box-shadow: var(--shared-card-shadow);
}
.main-content:not(:has(.explorer-page)) .admin-stat > span { flex: 0 0 34px; }
.main-content:not(:has(.explorer-page)) .admin-stat strong { margin-top: 6px; line-height: 1.15; }
.main-content:not(:has(.explorer-page)) .admin-stat small { margin-top: 0; line-height: 1.35; }
.main-content:not(:has(.explorer-page)) .admin-stat-grid { align-items: stretch; }

.main-content .view-heading > div > .eyebrow,
.about-copy > .eyebrow {
  display: block;
  margin-bottom: 8px;
  color: #5146ca;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  line-height: 1.35;
}
.main-content .view-heading > div > h1 { margin: 0; }
.main-content .view-heading > div > p { margin-top: 10px; }
.main-content .view-heading h1.standard-page-title,
.about-copy h1 {
  color: #111827;
  font-size: 42px;
  font-weight: 800;
  letter-spacing: -1.5px;
  line-height: 1.08;
}
.main-content .course-page .view-heading h1.standard-page-title {
  font-size: 42px;
}
.about-copy h1 { max-width: 620px; }
.main-content .view-heading h1.standard-page-title + p { margin-top: 10px; }
@media (max-width: 1024px) {
  .main-content .view-heading h1.standard-page-title,
  .main-content .course-page .view-heading h1.standard-page-title,
  .about-copy h1 {
    font-size: clamp(32px, 4vw, 36px);
  }
}
@media (max-width: 600px) {
  .main-content .view-heading h1.standard-page-title,
  .main-content .course-page .view-heading h1.standard-page-title,
  .about-copy h1 {
    font-size: clamp(26px, 7vw, 30px);
    letter-spacing: -1px;
  }
}
.main-content:not(:has(.explorer-page)) .course-match-page .quiz-box.quiz-generating {
  --card-accent: var(--category-purple);
  --card-pastel: var(--category-purple-pastel);
  border-top: 5px solid var(--category-purple);
  background: linear-gradient(145deg, var(--category-purple-pastel) 0%, rgba(255, 255, 255, .98) 88%);
  text-align: center;
}
.course-match-page .quiz-generating h1 {
  margin: 0 0 10px;
  color: #17213a;
  font-size: clamp(24px, 3vw, 30px);
  font-weight: 800;
  line-height: 1.2;
}
.course-match-page .quiz-generating .loading-spinner {
  border: 3px solid transparent;
  background:
    linear-gradient(var(--category-purple-pastel), var(--category-purple-pastel)) padding-box,
    conic-gradient(from 0deg, #4361EE 0%, #7C3AED 80%, transparent 90%, transparent 100%) border-box;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results [data-match-rank="1"] {
  --card-accent: #8B5CF6;
  --card-pastel: #F3EEFF;
  --match-ink: #7C3AED;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results [data-match-rank="2"] {
  --card-accent: #3B82F6;
  --card-pastel: #EFF6FF;
  --match-ink: #2563EB;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results [data-match-rank="3"] {
  --card-accent: #EC4899;
  --card-pastel: #FFF1F8;
  --match-ink: #DB2777;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .result-card[data-match-rank],
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .course-match-summary[data-match-rank],
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results > .result-head[data-match-rank],
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .course-match-explanations article[data-match-rank] {
  border-top-color: var(--card-accent);
  background: linear-gradient(145deg, var(--card-pastel) 0%, color-mix(in srgb, var(--card-pastel), white 42%) 100%);
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .result-card[data-match-rank] h3,
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results > .result-head[data-match-rank] h2,
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .course-match-explanations article[data-match-rank] h3 {
  color: #151B30;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .recommendation-rank {
  color: var(--match-ink);
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .compatibility-badges {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  white-space: normal;
  font-size: 13px;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .compatibility-percentage,
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .compatibility-strength {
  display: inline-block;
  padding: 6px 10px;
  border: 1px solid color-mix(in srgb, var(--card-accent), white 78%);
  border-radius: 999px;
  background: color-mix(in srgb, var(--card-pastel), white 30%);
  color: var(--match-ink);
  font-size: 13px;
  font-weight: 700;
  line-height: 1.25;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .result-card[data-match-rank] {
  border: 1px solid #E1E7F2;
  background: #fff;
  box-shadow: 0 7px 22px rgba(37, 56, 100, .07);
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .result-card[data-match-rank] .compatibility-progress {
  background: #E8ECF4;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .result-card[data-match-rank] .compatibility-progress span {
  background: var(--match-accent);
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .best-match-card {
  grid-template-columns: minmax(0, 1fr) 215px;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .course-quick-facts { grid-column: 1 / -1; }
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .course-quick-facts summary {
  color: #4F46E5;
  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .course-quick-facts .result-course-details {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 12px 0 0;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .course-quick-facts .result-course-details > div {
  background: #F7F9FD;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat [role="status"],
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-error {
  grid-column: 1 / -1;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-messages {
  grid-row: auto;
}
@media (max-width: 650px) {
  .main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .best-match-card {
    grid-template-columns: minmax(0, 1fr);
  }
  .main-content:not(:has(.explorer-page)) .course-match-page .course-match-results .course-quick-facts .result-course-details {
    grid-template-columns: minmax(0, 1fr);
  }
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat {
  display: flex;
  width: 100%;
  max-width: 850px;
  flex-direction: column;
  align-items: stretch;
  gap: 0;
  margin: 24px auto 0;
  padding: 0;
  overflow: hidden;
  border: 1px solid #E1E7F2;
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 8px 26px rgba(37, 56, 100, .08);
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .results-chat-heading {
  display: block;
  width: 100%;
  margin: 0;
  padding: 20px 24px 17px;
  border: 0;
  border-bottom: 1px solid #E8ECF4;
  border-radius: 0;
  background: #fff;
}
.main-content:not(:has(.explorer-page)) .course-match-page .assistant-title-row {
  display: flex;
  align-items: center;
  gap: 10px;
}
.main-content:not(:has(.explorer-page)) .course-match-page .assistant-title-row h2 {
  margin: 0;
  color: #14213D;
  font-size: 18px;
  font-weight: 750;
}
.main-content:not(:has(.explorer-page)) .course-match-page .assistant-availability {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #24784A;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}
.main-content:not(:has(.explorer-page)) .course-match-page .assistant-availability > i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #32A66A;
  box-shadow: 0 0 0 3px #E8F7EF;
}
.main-content:not(:has(.explorer-page)) .course-match-page .assistant-availability.unavailable {
  color: #7A6170;
}
.main-content:not(:has(.explorer-page)) .course-match-page .results-chat-heading > p {
  margin: 6px 0 0;
  color: #64718A;
  font-size: 13px;
  line-height: 1.5;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-messages {
  display: flex;
  min-height: 350px;
  max-height: 400px;
  flex-direction: column;
  align-items: stretch;
  gap: 14px;
  padding: 20px 24px;
  overflow-x: hidden;
  overflow-y: auto;
  background: #fff;
  overscroll-behavior: contain;
  scroll-behavior: smooth;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-message {
  width: fit-content;
  max-width: 80%;
  min-width: 0;
  padding: 14px 17px;
  border: 0;
  border-radius: 14px;
  overflow-wrap: anywhere;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-message.assistant {
  align-self: flex-start;
  background: #F3F0FF;
  color: #14213D;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-message.user {
  align-self: flex-end;
  background: #E8F0FF;
  color: #14213D;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-role {
  margin-bottom: 5px;
  color: #4F46E5;
  font-size: 11px;
  font-weight: 700;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-message.user .chat-role {
  color: #3156A6;
  text-align: right;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-message p {
  margin: 0;
  color: #14213D;
  font-size: 13px;
  line-height: 1.55;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-empty-state {
  align-self: center;
  margin: auto;
  color: #78849A;
  font-size: 13px;
  line-height: 1.5;
  text-align: center;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-typing-message {
  min-width: 128px;
}
.main-content:not(:has(.explorer-page)) .course-match-page .typing-indicator {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  min-height: 15px;
}
.main-content:not(:has(.explorer-page)) .course-match-page .typing-indicator > i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #7267D8;
  animation: course-match-typing 1.1s ease-in-out infinite;
}
.main-content:not(:has(.explorer-page)) .course-match-page .typing-indicator > i:nth-child(2) { animation-delay: .15s; }
.main-content:not(:has(.explorer-page)) .course-match-page .typing-indicator > i:nth-child(3) { animation-delay: .3s; }
@keyframes course-match-typing {
  0%, 60%, 100% { opacity: .35; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-3px); }
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat > .chat-error,
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat > [role="status"] {
  margin: 0;
  padding: 10px 24px 0;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-form {
  display: flex;
  width: 100%;
  align-items: stretch;
  gap: 10px;
  margin: 0;
  padding: 15px 20px 18px;
  border-top: 1px solid #E8ECF4;
  background: #fff;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-form textarea {
  flex: 1 1 auto;
  width: 0;
  min-width: 0;
  min-height: 48px;
  max-height: 120px;
  resize: vertical;
  padding: 12px 14px;
  border: 1px solid #DDE4F0;
  border-radius: 11px;
  background: #fff;
  color: #14213D;
  font: inherit;
  font-size: 13px;
  line-height: 1.45;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-form textarea:focus {
  border-color: #6D5DFB;
  outline: 3px solid rgba(109, 93, 251, .12);
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-form .primary-btn {
  display: inline-flex;
  min-width: 82px;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 10px 15px;
  border: 0;
  border-radius: 10px;
  background: #4F46E5;
  box-shadow: none;
  color: #fff;
  font-size: 13px;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-form .primary-btn:hover:not(:disabled) {
  background: #4338CA;
}
.main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-form .primary-btn:disabled {
  cursor: not-allowed;
  opacity: .52;
}
@media (min-width: 701px) and (max-width: 850px) {
  .screen.landing:has(.hero-grid) .hero-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }
  .screen.landing:has(.hero-grid) .hero h1 {
    font-size: clamp(54px, 8vw, 66px);
  }
  .screen.landing:has(.hero-grid) .hero-art {
    width: min(100%, 560px);
    min-height: 370px;
    margin: 0 auto;
  }
}
@media (max-width: 700px) {
  .main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat {
    margin-top: 20px;
  }
  .main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .results-chat-heading {
    padding: 17px 18px 15px;
  }
  .main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-messages {
    min-height: 350px;
    max-height: 400px;
    padding: 16px 18px;
  }
  .main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-message {
    max-width: 80%;
  }
  .main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-form {
    gap: 8px;
    padding: 12px 14px 15px;
    flex-direction: row;
  }
  .main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-form textarea {
    width: auto;
    min-width: 0;
    flex: 1 1 auto;
  }
  .main-content:not(:has(.explorer-page)) .course-match-page .course-match-results-chat .chat-form .primary-btn {
    min-width: 76px;
    min-height: 46px;
    flex: 0 0 auto;
  }
}
@media (prefers-reduced-motion: reduce) {
  .main-content:not(:has(.explorer-page)) .course-match-page .typing-indicator > i {
    animation: none;
    opacity: 1;
  }
}

.main-content .profile-page .activity-column {
  display: grid;
  gap: 18px;
}
.main-content .profile-page .profile-card,
.main-content .profile-page .activity-stats > div,
.main-content .profile-page .saved-session {
  border: 1px solid #E2E8F0;
  border-radius: 15px;
  box-shadow: 0 6px 18px rgba(74, 91, 145, .08);
  transition: transform .2s ease, box-shadow .2s ease;
}
.main-content .profile-page .profile-card {
  margin-bottom: 0;
}
.main-content .profile-page .profile-layout > .profile-card {
  background: linear-gradient(135deg, #F0F7FF, #F5EDFF, #FFFFFF);
}
.main-content .profile-page .activity-column > .profile-card:first-child {
  background: linear-gradient(135deg, #FFFFFF, #F8F3FF);
}
.main-content .profile-page .activity-column > .profile-card:last-child {
  background: linear-gradient(135deg, #F0F8FF, #FAF3FF, #FFFFFF);
}
.main-content .profile-page .activity-stats > div {
  padding: 13px;
  background: linear-gradient(135deg, #EAF3FF, #F8FBFF);
}
.main-content .profile-page .activity-stats > div:nth-child(2) {
  background: linear-gradient(135deg, #F1EAFF, #FAF7FF);
}
.main-content .profile-page .activity-stats > div:nth-child(3) {
  background: linear-gradient(135deg, #FCEAF4, #FFF8FC);
}
.main-content .profile-page .saved-session {
  background: linear-gradient(135deg, #FFFFFF, #FAF8FF);
}
.main-content .profile-page .profile-card:hover,
.main-content .profile-page .activity-stats > div:hover,
.main-content .profile-page .saved-session:hover {
  transform: translateY(-2px);
  box-shadow: 0 9px 22px rgba(74, 91, 145, .12);
}
@media (min-width: 601px) and (max-width: 900px) {
  .main-content .profile-page .profile-layout {
    grid-template-columns: minmax(220px, .8fr) minmax(0, 1.4fr);
    gap: 16px;
  }
  .main-content .profile-page .activity-stats {
    gap: 8px;
  }
}

.main-content:not(:has(.explorer-page)) .about-list {
  gap: 14px;
}
.main-content:not(:has(.explorer-page)) .about-point {
  border: 1px solid #E2E8F0;
  border-radius: 15px;
  padding: 20px;
  box-shadow: 0 6px 18px rgba(74, 91, 145, .08);
  transition: transform .2s ease, box-shadow .2s ease;
}
.main-content:not(:has(.explorer-page)) .about-point:nth-child(1) {
  background: linear-gradient(135deg, #EAF3FF, #FFFFFF);
}
.main-content:not(:has(.explorer-page)) .about-point:nth-child(2) {
  background: linear-gradient(135deg, #F1EAFF, #FFFFFF);
}
.main-content:not(:has(.explorer-page)) .about-point:nth-child(3) {
  background: linear-gradient(135deg, #FCEAF4, #FFFFFF);
}
.main-content:not(:has(.explorer-page)) .about-point > div {
  min-width: 0;
}
.main-content:not(:has(.explorer-page)) .about-point:hover {
  transform: translateY(-2px);
  box-shadow: 0 9px 22px rgba(74, 91, 145, .12);
}
@media (min-width: 601px) and (max-width: 900px) {
  .main-content:not(:has(.explorer-page)) .about-grid {
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    gap: clamp(18px, 4vw, 32px);
  }
}
@media (max-width: 600px) {
  .main-content:not(:has(.explorer-page)) .about-grid {
    gap: 24px;
  }
  .main-content:not(:has(.explorer-page)) .about-point {
    padding: 18px;
  }
}

.screen.landing:has(.hero-grid) {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: linear-gradient(135deg, #E0ECFF 0%, #EDE9FE 55%, #FCE7F3 100%);
  color: #102344;
}
.screen.landing:has(.hero-grid) .landing-nav {
  width: 100%;
  min-height: 82px;
  padding: 15px max(32px, calc((100vw - 1280px) / 2));
  border: 0;
  background: #102344;
}
.screen.landing:has(.hero-grid) .landing-nav .brand {
  color: #fff;
  font-size: 22px;
}
.screen.landing:has(.hero-grid) .landing-nav .brand-mark {
  background: linear-gradient(135deg, #4361EE, #7C3AED);
}
.screen.landing:has(.hero-grid) .nav-actions {
  gap: 26px;
}
.screen.landing:has(.hero-grid) .landing-nav .text-btn {
  display: inline-flex;
  color: #fff;
}
.screen.landing:has(.hero-grid) .landing-nav .primary-btn {
  border-radius: 11px;
  padding: 12px 17px;
  background: linear-gradient(135deg, #4361EE, #7C3AED);
  box-shadow: 0 5px 14px rgba(67, 97, 238, .2);
  color: #fff;
}
.screen.landing:has(.hero-grid) .landing-main {
  width: 100%;
  max-width: none;
  flex: 1;
  padding: 52px max(32px, calc((100vw - 1280px) / 2)) 38px;
  background: transparent;
  color: #102344;
}
.screen.landing:has(.hero-grid) .hero-grid {
  width: 100%;
  max-width: 1280px;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
  gap: clamp(32px, 5vw, 72px);
  margin: 0 auto;
}
.screen.landing:has(.hero-grid) .hero {
  min-width: 0;
}
.screen.landing:has(.hero-grid) .hero .eyebrow {
  color: #5146ca;
  font-size: 11px;
  letter-spacing: 1.7px;
}
.screen.landing:has(.hero-grid) .hero h1 {
  max-width: 660px;
