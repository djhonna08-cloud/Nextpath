.hero-note { display: none !important; }
.admin-stat-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; margin-bottom:20px; }
.admin-stat { min-width:0; padding:18px; border:1px solid var(--line); border-radius:var(--radius); background:white; }
.admin-stat > span { display:grid; place-items:center; width:34px; height:34px; border-radius:10px; background:var(--mint); color:var(--teal); }
.admin-stat strong,.admin-stat small { display:block; }
.admin-stat strong { margin-top:12px; font:700 27px 'Space Grotesk',sans-serif; }
.admin-stat small { margin-top:4px; color:var(--muted); font-size:12px; }
.admin-insights { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; margin-bottom:20px; }
.admin-insights .profile-card h2 { margin-bottom:15px; font-size:18px; }
.admin-registration-list { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:8px; }
.admin-registration-list > div { min-width:0; padding:9px 4px; background:var(--paper); border-radius:8px; text-align:center; }
.admin-registration-list span,.admin-registration-list strong { display:block; }
.admin-registration-list span { color:var(--muted); font-size:10px; overflow:hidden; }
.admin-registration-list strong { margin-top:5px; }
.admin-top-courses { display:grid; gap:10px; padding-left:20px; margin:0; }
.admin-top-courses li { padding-left:3px; }
.admin-top-courses li span { display:inline-block; width:calc(100% - 38px); }
.admin-top-courses strong { float:right; }
.admin-user-count,.admin-footnote { margin:5px 0 0; color:var(--muted); font-size:12px; }
.admin-search { display:flex; gap:8px; }
.admin-search input { min-width:180px; padding:10px 12px; border:1px solid var(--line); border-radius:9px; }
.admin-table-wrap { overflow-x:auto; }
.admin-users-table { width:100%; border-collapse:collapse; font-size:13px; text-align:left; }
.admin-users-table th,.admin-users-table td { padding:12px 10px; border-bottom:1px solid var(--line); white-space:nowrap; }
.admin-users-table th { color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.04em; }
.admin-role { padding:4px 8px; border-radius:99px; background:var(--paper); }
.admin-role.is-admin { background:#fff0d0; color:#805900; }
.admin-error { margin-bottom:18px; }
.admin-load-error { display:flex; align-items:center; justify-content:space-between; gap:14px; }
.admin-load-error .admin-error { margin:0; }
.admin-page[aria-busy="true"] .admin-stat-grid { opacity:.65; }
.admin-pagination { display:flex; justify-content:space-between; align-items:center; gap:14px; margin-top:14px; }
.admin-pagination > div { display:flex; gap:8px; }
.admin-pagination .secondary-btn { padding:9px 12px; }
.admin-pagination .secondary-btn:disabled { opacity:.5; cursor:not-allowed; }
.admin-chart svg { width:100%; overflow:visible; color:var(--muted); }
.admin-chart text { fill:var(--muted); }
.admin-inline-form,.admin-course-form,.admin-settings-form { display:grid; gap:12px; margin:16px 0 20px; padding:16px; border:1px solid var(--line); border-radius:12px; background:#fbfcfa; }
.admin-inline-form { grid-template-columns:repeat(4,minmax(130px,1fr)); align-items:center; }
.admin-inline-form h3,.admin-inline-form p { grid-column:1/-1; }
.admin-inline-form input,.admin-inline-form select,.admin-form-grid input,.admin-form-grid textarea,.admin-form-grid select,.admin-users-table select,.admin-settings-form input:not([type=checkbox]) { width:100%; min-width:0; padding:10px 12px; border:1px solid var(--line); border-radius:9px; background:white; color:var(--ink); }
.admin-inline-form .primary-btn { grid-column:1/-1; justify-self:start; }
.admin-form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.admin-form-grid .form-field { display:grid; gap:7px; color:var(--muted); font-size:13px; }
.admin-form-grid textarea { resize:vertical; }
.admin-course-form > h3 { font-size:18px; }
.admin-actions { display:flex; flex-wrap:wrap; align-items:center; gap:6px; }
.admin-actions .secondary-btn,.admin-actions .primary-btn { padding:8px 10px; font-size:12px; }
.admin-users-table select { min-width:115px; padding:7px 8px; }
.admin-course-list { display:grid; gap:8px; }
.admin-course-list > div { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:12px; border:1px solid var(--line); border-radius:10px; }
.admin-course-list small,.admin-course-list strong { display:block; }
.admin-course-list small { margin-top:3px; color:var(--muted); }
.admin-settings-form > label:not(.form-field) { display:flex; gap:8px; align-items:center; color:var(--muted); }
.admin-settings-form .form-field { display:grid; gap:7px; }
.admin-settings-form .primary-btn { justify-self:start; }
textarea { font:inherit; }
@media(max-width:1000px) { .admin-stat-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }.admin-insights { grid-template-columns:1fr; } }
@media(max-width:600px) { .admin-stat-grid { grid-template-columns:1fr 1fr; gap:8px; }.admin-stat { padding:12px; }.admin-stat strong { font-size:22px; }.admin-users-card .section-title { align-items:flex-start; flex-direction:column; gap:12px; }.admin-search,.admin-search input { width:100%; }.admin-registration-list { gap:3px; }.admin-registration-list span { font-size:8px; }.admin-inline-form,.admin-form-grid { grid-template-columns:1fr; }.admin-inline-form .primary-btn { grid-column:auto; }.admin-course-list > div { align-items:flex-start; flex-direction:column; } }
:root {
  --ink: #102a43;
  --muted: #62748a;
  --paper: #f7f8f3;
  --white: #ffffff;
  --line: #dfe7eb;
  --teal: #0f766e;
  --teal-dark: #095c57;
  --mint: #dcf4ea;
  --coral: #ed775f;
  --yellow: #f7d774;
  --lavender: #e8e7fb;
  --shadow: 0 18px 50px rgba(16, 42, 67, .08);
  --radius: 18px;
}
* { box-sizing: border-box; }
body { margin: 0; color: var(--ink); background: var(--paper); font-family: 'DM Sans', sans-serif; }
button, input { font: inherit; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible { outline: 3px solid rgba(237,119,95,.4); outline-offset: 2px; }
.screen { min-height: 100vh; }
.landing { background: var(--paper); overflow: hidden; }
.landing-nav { max-width: 1180px; margin: auto; padding: 28px 32px; display: flex; align-items: center; justify-content: space-between; }
.brand { display: flex; gap: 10px; align-items: center; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 21px; letter-spacing: -.5px; }
.brand-mark { width: 33px; height: 33px; border-radius: 10px; background: linear-gradient(135deg, #3068FF, #7C3AED); display: grid; place-items: center; color: #fff; font-family: 'DM Sans', sans-serif; font-size: 22px; font-weight: 800; line-height: 1; flex: 0 0 auto; }
.nav-actions { display:flex; gap: 24px; align-items: center; }
.text-btn { border: 0; background: transparent; color: var(--ink); font-weight: 600; padding: 9px 0; }
.primary-btn, .secondary-btn { border: 0; border-radius: 9px; padding: 13px 19px; font-weight: 700; transition: transform .2s, background .2s; }
.primary-btn { background: var(--teal); color: white; }
.primary-btn:hover { background: var(--teal-dark); transform: translateY(-2px); }
.secondary-btn { background: white; color: var(--ink); border: 1px solid var(--line); }
.secondary-btn:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
.landing-main { max-width: 1180px; margin: auto; padding: 64px 32px 80px; }
.hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 80px; align-items: center; }
.eyebrow { color: var(--teal); text-transform: uppercase; letter-spacing: 1.5px; font-size: 12px; font-weight: 700; }
h1, h2, h3 { font-family: 'Space Grotesk', sans-serif; letter-spacing: -1.4px; margin: 0; }
.hero h1 { font-size: clamp(48px, 6vw, 78px); line-height: .98; max-width: 640px; margin: 18px 0 24px; }
.hero h1 em { color: var(--coral); font-style: normal; }
.hero-copy { font-size: 18px; line-height: 1.65; color: var(--muted); max-width: 540px; margin: 0 0 32px; }
.hero-actions { display:flex; gap: 12px; align-items: center; }
.hero-note { display:flex; gap:10px; align-items:center; color:var(--muted); font-size:13px; margin-top:24px; }
.hero-note .avatars { display:flex; }
.avatar { width:27px; height:27px; display:grid; place-items:center; background:var(--yellow); border:2px solid var(--paper); border-radius:50%; font-size:11px; margin-left:-6px; }
.avatar:first-child { margin-left:0; background:var(--mint); }
.avatar:last-child { background:var(--lavender); }
.hero-art { position:relative; min-height: 510px; }
.art-paper { position:absolute; inset: 35px 12px 0 25px; background: #ccefe2; border-radius: 44% 55% 36% 62%; transform: rotate(5deg); }
.art-card { position:absolute; background: white; border: 1px solid rgba(16,42,67,.08); box-shadow: var(--shadow); border-radius: 14px; padding: 18px; }
.art-main { top:95px; left:76px; width: 285px; transform: rotate(-6deg); }
.art-mini { right: 15px; bottom: 74px; width: 190px; transform: rotate(7deg); }
.art-label { font-size:12px; color:var(--muted); font-weight:600; }
.art-main h3 { margin:9px 0 17px; font-size:22px; }
.fake-bars { display:grid; gap:9px; }
.fake-bars span { height:10px; border-radius:8px; background:#edf2f2; display:block; }
.fake-bars span:nth-child(1) { width:90%; background:var(--coral); }.fake-bars span:nth-child(2) { width:72%; background:var(--yellow); }.fake-bars span:nth-child(3) { width:80%; background:var(--teal); }
.path-circle { position:absolute; right:55px; top:25px; background:var(--yellow); border-radius:50%; width:90px; height:90px; display:grid; place-items:center; transform:rotate(12deg); }
.path-circle svg { width:35px; height:35px; }
.art-mini h4 { margin:7px 0; font-size:14px; }.mini-line { display:flex; gap:5px; margin-top:12px; }.mini-line b { width:7px; height:7px; background:var(--teal); border-radius:50%; }.mini-line b:nth-child(2) { background:var(--coral); }.mini-line b:nth-child(3) { background:var(--yellow); }
.feature-strip { max-width:1180px; margin:0 auto; padding: 0 32px 75px; display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
.feature { display:flex; gap:15px; align-items:flex-start; border-top:1px solid var(--line); padding-top:20px; }.feature-icon { width:36px; height:36px; border-radius:10px; display:grid; place-items:center; background:var(--mint); color:var(--teal); flex:none; }.feature:nth-child(2) .feature-icon { background:#fff0d0; color:#c18a00; }.feature:nth-child(3) .feature-icon { background:#fbe0dc; color:#d65343; }.feature h3 { font-size:16px; letter-spacing:-.3px; margin-bottom:6px; }.feature p { margin:0; color:var(--muted); font-size:13px; line-height:1.5; }
.auth-wrap { min-height:100vh; display:grid; grid-template-columns: 1fr 1fr; background:var(--paper); }.auth-side { padding:55px clamp(28px, 6vw, 90px); background:var(--teal); color:white; display:flex; flex-direction:column; justify-content:space-between; }.auth-side .brand { color:white; }.auth-side .brand-mark { background:var(--coral); }.auth-side h1 { font-size:clamp(36px,4vw,58px); line-height:1.03; max-width:450px; }.auth-side p { color:#c6e6dd; line-height:1.6; max-width:420px; }.side-art { font-size:72px; color:var(--yellow); font-family:'Space Grotesk'; line-height:.8; }.auth-form-wrap { display:grid; place-items:center; padding:40px 30px; }.auth-form { width:min(410px,100%); }.auth-form h2 { font-size:36px; margin:11px 0; }.auth-form > p { color:var(--muted); margin:0 0 30px; }.form-field { display:grid; gap:8px; margin-bottom:17px; }.form-field label { font-size:13px; font-weight:700; }.form-field input { width:100%; padding:14px 15px; border:1px solid var(--line); border-radius:9px; background:white; color:var(--ink); }.form-submit { width:100%; margin-top:6px; }.form-switch { text-align:center; color:var(--muted); font-size:13px; margin-top:23px; }.form-switch button { color:var(--teal); font-weight:700; border:0; background:none; }.error { color:#c64b3c; font-size:13px; margin-bottom:13px; }.back-link { display:flex; align-items:center; gap:7px; color:var(--muted); border:0; background:none; padding:0; font-size:13px; margin-bottom:25px; }
.app-shell { min-height:100vh; display:grid; grid-template-columns:238px 1fr; }.sidebar { background:var(--white); border-right:1px solid var(--line); padding:27px 18px; display:flex; flex-direction:column; }.sidebar .brand { padding:0 12px 38px; }.nav-list { display:grid; gap:5px; }.nav-item { border:0; background:transparent; display:flex; align-items:center; gap:12px; padding:12px; color:var(--muted); font-weight:600; text-align:left; border-radius:9px; }.nav-item:hover, .nav-item.active { background:var(--mint); color:var(--teal); }.sidebar-footer { margin-top:auto; border-top:1px solid var(--line); padding:18px 12px 0; display:flex; align-items:center; gap:10px; }.user-dot { width:32px;height:32px;border-radius:50%;background:var(--yellow);display:grid;place-items:center;font-weight:700; }.user-info { overflow:hidden; }.user-info strong,.user-info span { display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }.user-info span { color:var(--muted); font-size:11px; margin-top:2px; }
.main-content { padding:34px clamp(22px, 4vw, 56px); max-width:1440px; width:100%; }.topbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:40px; }.mobile-menu { display:none; }.topbar-note { color:var(--muted); font-size:13px; }.view-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:26px; }.view-heading h1 { font-size:38px; }.view-heading p { color:var(--muted); margin:7px 0 0; }.welcome-banner { background:var(--teal); color:white; border-radius:var(--radius); padding:30px 34px; display:flex; justify-content:space-between; align-items:center; overflow:hidden; position:relative; margin-bottom:30px; }.welcome-banner:after { content:''; position:absolute; width:230px; height:230px; border:42px solid rgba(255,255,255,.08); border-radius:50%; right:50px; top:-100px; }.welcome-banner h1 { font-size:32px; margin-bottom:8px; }.welcome-banner p { margin:0; color:#c6e6dd; }.banner-action { position:relative; z-index:1; background:var(--yellow); color:var(--ink); border:0; border-radius:9px; padding:14px 18px; font-weight:700; display:flex; align-items:center; gap:8px; }.stat-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-bottom:34px; }.stat-card { background:white; border:1px solid var(--line); border-radius:var(--radius); padding:20px; }.stat-card > div { display:flex; justify-content:space-between; align-items:center; color:var(--muted); font-size:13px; }.stat-card strong { display:block; font-family:'Space Grotesk'; font-size:29px; margin-top:14px; }.stat-icon { color:var(--teal); }.section-title { display:flex; justify-content:space-between; align-items:center; margin-bottom:17px; }.section-title h2 { font-size:22px; }.link-btn { color:var(--teal); border:0; background:none; font-size:13px; font-weight:700; }.course-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }.course-card { background:white; border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; cursor:pointer; transition:transform .2s, box-shadow .2s; }.course-card:hover { transform:translateY(-4px); box-shadow:var(--shadow); }.course-color { height:8px; background:var(--teal); }.course-card:nth-child(2) .course-color { background:var(--coral); }.course-card:nth-child(3) .course-color { background:var(--yellow); }.course-card-body { padding:19px; }.category { color:var(--teal); font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.8px; }.course-card h3 { font-size:19px; margin:8px 0 9px; }.course-card p { color:var(--muted); font-size:13px; line-height:1.5; margin:0 0 18px; min-height:40px; }.card-foot { display:flex; align-items:center; justify-content:space-between; border-top:1px solid #edf1f2; padding-top:14px; }.skill-pills { display:flex; gap:5px; flex-wrap:wrap; }.pill { background:var(--paper); color:var(--muted); font-size:10px; border-radius:5px; padding:5px 7px; }.arrow { color:var(--teal); }
.explorer-tools { display:flex; gap:12px; margin-bottom:24px; }.search-box { background:white; border:1px solid var(--line); border-radius:9px; display:flex; align-items:center; gap:9px; padding:0 13px; flex:1; max-width:430px; color:var(--muted); }.search-box input { border:0; outline:0; width:100%; padding:13px 0; background:transparent; }.filter-select { border:1px solid var(--line); border-radius:9px; padding:0 14px; background:white; color:var(--ink); }.empty { padding:40px; border:1px dashed var(--line); border-radius:var(--radius); text-align:center; color:var(--muted); }.detail-back { display:inline-flex; gap:7px; align-items:center; color:var(--teal); border:0; background:none; font-weight:700; padding:0; margin-bottom:28px; }.detail-hero { background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:32px; margin-bottom:20px; }.detail-hero h1 { font-size:42px; margin:9px 0 12px; }.detail-hero p { color:var(--muted); max-width:700px; line-height:1.6; margin:0; }.detail-layout { display:grid; grid-template-columns:1.4fr .8fr; gap:20px; }.detail-panel { background:white; border:1px solid var(--line); border-radius:var(--radius); padding:24px; margin-bottom:20px; }.detail-panel h2 { font-size:19px; margin-bottom:18px; }.detail-panel ul { padding:0; margin:0; list-style:none; display:grid; gap:12px; }.detail-panel li { display:flex; gap:10px; color:var(--muted); font-size:14px; line-height:1.5; }.detail-panel li svg { color:var(--teal); flex:none; margin-top:2px; }.tag-list { display:flex; flex-wrap:wrap; gap:8px; }.tag-list span { padding:8px 10px; background:var(--mint); color:var(--teal); border-radius:6px; font-size:12px; font-weight:600; }.career-list li { color:var(--ink); }.career-list li:before { content:'↗'; color:var(--coral); font-weight:bold; }.match-card { background:var(--teal); color:white; }.match-card p { color:#c6e6dd; font-size:13px; line-height:1.5; }.match-card .primary-btn { background:var(--yellow); color:var(--ink); margin-top:7px; }
.chat-panel { max-width:820px; background:white; border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; }.chat-messages { min-height:280px; max-height:56vh; overflow-y:auto; padding:22px; display:grid; align-content:start; gap:14px; }.chat-message { max-width:88%; padding:13px 16px; border-radius:12px; background:var(--paper); }.chat-message.user { justify-self:end; background:var(--mint); }.chat-role { display:block; color:var(--teal); font-size:11px; font-weight:700; margin-bottom:6px; }.chat-message p { margin:0; color:var(--ink); font-size:14px; line-height:1.6; overflow-wrap:anywhere; }.chat-form { display:flex; align-items:flex-end; gap:10px; padding:16px 20px; border-top:1px solid var(--line); }.chat-form textarea { flex:1; resize:vertical; min-height:48px; max-height:140px; padding:12px; border:1px solid var(--line); border-radius:9px; font:inherit; color:var(--ink); }.chat-form button { display:flex; align-items:center; gap:8px; }.chat-form button:disabled { opacity:.6; cursor:wait; }.chat-notice { margin:0; padding:0 20px 16px; color:var(--muted); font-size:11px; line-height:1.5; }.chat-error { margin:0; padding:12px 20px 0; color:#c64b3c; font-size:13px; }.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; } color:var(--ink); }.career-list li:before { content:'↗'; color:var(--coral); font-weight:bold; }.match-card { background:var(--teal); color:white; }.match-card p { color:#c6e6dd; font-size:13px; line-height:1.5; }.match-card .primary-btn { background:var(--yellow); color:var(--ink); margin-top:7px; }
.chat-message p { white-space:pre-wrap; }
.course-match-chat { padding:0; overflow:hidden; }
.course-match-chat .chat-messages { min-height:280px; }
.course-match-chat .chat-form { margin:0; }.chat-form { display:flex; align-items:flex-end; gap:10px; padding:16px 20px; border-top:1px solid var(--line); }.chat-form textarea { flex:1; resize:vertical; min-height:48px; max-height:140px; padding:12px; border:1px solid var(--line); border-radius:9px; font:inherit; color:var(--ink); }.chat-form button { display:flex; align-items:center; gap:8px; }.chat-form button:disabled { opacity:.6; cursor:wait; }.chat-notice { margin:0; padding:0 20px 16px; color:var(--muted); font-size:11px; line-height:1.5; }.chat-error { margin:0; padding:12px 20px 0; color:#c64b3c; font-size:13px; }.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; } color:var(--ink); }.career-list li:before { content:'↗'; color:var(--coral); font-weight:bold; }.match-card { background:var(--teal); color:white; }.match-card p { color:#c6e6dd; font-size:13px; line-height:1.5; }.match-card .primary-btn { background:var(--yellow); color:var(--ink); margin-top:7px; }
.quiz-intro { background:#fff0d0; border-radius:var(--radius); padding:25px 28px; margin-bottom:22px; display:flex; gap:18px; align-items:flex-start; }.quiz-intro svg { color:#c18a00; flex:none; }.quiz-intro h3 { font-size:18px; margin-bottom:5px; }.quiz-intro p { color:var(--muted); margin:0; font-size:13px; line-height:1.5; }.quiz-progress { display:flex; gap:5px; margin:25px 0 18px; }.quiz-progress span { height:5px; flex:1; background:var(--line); border-radius:4px; }.quiz-progress span.done, .quiz-progress span.current { background:var(--teal); }.quiz-box { background:white; border:1px solid var(--line); border-radius:var(--radius); padding:32px; max-width:820px; }.quiz-box h2 { font-size:26px; margin-bottom:23px; }.answer-grid { display:grid; grid-template-columns:1fr 1fr; gap:11px; }.answer { text-align:left; padding:16px; background:white; border:1px solid var(--line); border-radius:10px; color:var(--ink); font-weight:600; transition:border .2s, background .2s; }.answer:hover { border-color:var(--teal); background:var(--mint); }.answer.selected { border:2px solid var(--teal); background:var(--mint); }.quiz-footer { margin-top:26px; display:flex; justify-content:space-between; align-items:center; }.step-label { color:var(--muted); font-size:13px; }.result-head { text-align:center; max-width:650px; margin:0 auto 28px; }.result-head h1 { font-size:40px; margin:12px 0; }.result-head p { color:var(--muted); line-height:1.6; }.result-card { background:white; border:2px solid var(--teal); border-radius:var(--radius); padding:24px; display:flex; justify-content:space-between; align-items:center; gap:20px; margin-bottom:12px; }.result-card h3 { font-size:20px; margin:6px 0; }.result-card p { color:var(--muted); font-size:13px; margin:0; }.score { color:var(--teal); font-family:'Space Grotesk'; font-size:26px; font-weight:700; }
.about-grid { display:grid; grid-template-columns:1fr 1fr; gap:25px; align-items:start; }.about-copy h1 { font-size:48px; margin:12px 0 18px; }.about-copy p { color:var(--muted); line-height:1.7; max-width:520px; }.about-list { display:grid; gap:12px; }.about-point { background:white; border:1px solid var(--line); border-radius:var(--radius); padding:20px; display:flex; gap:15px; }.about-point span { width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--mint); color:var(--teal); font-weight:700; flex:none; }.about-point h3 { font-size:16px; margin-bottom:6px; }.about-point p { color:var(--muted); font-size:13px; line-height:1.5; margin:0; }
.toast { position:fixed; right:20px; bottom:20px; background:var(--ink); color:white; padding:14px 17px; border-radius:9px; box-shadow:var(--shadow); font-size:13px; z-index:10; animation:slideIn .3s ease-out; } @keyframes slideIn { from { transform:translateY(15px); opacity:0; } to { transform:translateY(0); opacity:1; } }
@media (max-width: 900px) { .hero-grid, .auth-wrap { grid-template-columns:1fr; }.hero-art { min-height:360px; max-width:500px; width:100%; margin:auto; }.auth-side { min-height:300px; gap:35px; }.auth-side .side-art { display:none; }.course-grid { grid-template-columns:1fr 1fr; }.detail-layout, .about-grid { grid-template-columns:1fr; }.app-shell { grid-template-columns:1fr; }.sidebar { position:fixed; z-index:5; top:0; bottom:0; left:-250px; width:238px; transition:left .2s; box-shadow:var(--shadow); }.sidebar.open { left:0; }.mobile-menu { display:grid; place-items:center; border:0; background:white; color:var(--ink); width:40px; height:40px; border-radius:8px; }.topbar { gap:12px; }.topbar-note { margin-left:auto; } }
@media (max-width: 600px) { .landing-nav { padding:20px; }.landing-nav .text-btn { display:none; }.landing-main { padding:43px 20px 55px; }.hero h1 { font-size:49px; }.hero-copy { font-size:16px; }.hero-actions { flex-direction:column; align-items:stretch; }.hero-actions button { width:100%; }.hero-art { min-height:305px; transform:scale(.85); transform-origin:center top; margin-bottom:-45px; }.feature-strip { grid-template-columns:1fr; padding:0 20px 45px; }.course-grid, .stat-grid { grid-template-columns:1fr; }.main-content { padding:20px 16px; }.view-heading { align-items:flex-start; flex-direction:column; }.view-heading h1 { font-size:31px; }.welcome-banner { padding:23px; display:block; }.welcome-banner h1 { font-size:27px; }.banner-action { margin-top:20px; }.explorer-tools { flex-direction:column; }.search-box { max-width:none; }.filter-select { padding:13px; }.detail-hero { padding:23px; }.detail-hero h1 { font-size:32px; }.quiz-box { padding:22px; }.answer-grid { grid-template-columns:1fr; }.result-card { display:block; }.result-card .primary-btn { margin-top:15px; }.about-copy h1 { font-size:38px; }.auth-form-wrap { padding:35px 23px; } }
.chat-widget { position:fixed; z-index:20; right:20px; bottom:20px; display:flex; flex-direction:column; align-items:flex-end; gap:10px; }
.chat-launcher { width:48px; height:48px; min-width:48px; min-height:48px; max-width:48px; max-height:48px; flex:0 0 48px; display:grid; place-items:center; padding:0; border:0; border-radius:10px; background:#151D2B; color:#fff; box-shadow:0 4px 12px rgba(16,24,40,.2); transition:background .18s ease, box-shadow .18s ease, transform .18s ease; }
.chat-launcher:hover { background:#202A3B; box-shadow:0 6px 15px rgba(16,24,40,.24); transform:translateY(-2px); }
.chat-launcher svg { display:block; width:22px; height:22px; flex:none; stroke-width:2; }
.chat-launcher:focus-visible { outline:3px solid rgba(67,97,238,.5); outline-offset:3px; }
.chat-panel { width:min(390px, calc(100vw - 32px)); max-height:min(620px, calc(100vh - 48px)); display:flex; flex-direction:column; border-radius:16px; box-shadow:0 16px 48px rgba(16,42,67,.22); }
.chat-widget-header { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 16px; background:var(--teal); color:white; }
.chat-widget-title { display:flex; align-items:center; gap:11px; }
.chat-widget-title > svg { flex:none; }
.chat-widget-title strong,.chat-widget-title span { display:block; }
.chat-widget-title strong { font-size:14px; }
.chat-widget-title span { margin-top:2px; color:#c6e6dd; font-size:11px; }
.chat-collapse { width:34px; height:34px; display:grid; place-items:center; flex:none; border:0; border-radius:50%; background:rgba(255,255,255,.14); color:white; }
.chat-collapse:hover { background:rgba(255,255,255,.25); }
.chat-widget .chat-messages { min-height:170px; max-height:min(38vh, 340px); padding:16px; gap:11px; }
.chat-widget .chat-message { max-width:94%; padding:11px 13px; }
.chat-widget .chat-form { gap:8px; padding:12px; }
.chat-widget .chat-form textarea { min-height:42px; max-height:96px; padding:10px; font-size:13px; }
.chat-widget .chat-form button { width:42px; height:42px; justify-content:center; padding:0; flex:none; }
.chat-widget .chat-notice { padding:0 12px 12px; font-size:10px; }
.chat-widget .chat-error { padding:10px 12px 0; }
.chat-suggestions { display:grid; justify-items:start; gap:7px; margin-top:12px; }
.chat-suggestion { padding:7px 10px; border:1px solid var(--line); border-radius:16px; background:white; color:var(--teal); font-size:12px; font-weight:600; text-align:left; }
.chat-suggestion:hover { border-color:var(--teal); background:var(--mint); }
.photo-placeholder { background:#f7d774; color:var(--ink); }
.photo-ocean { background:#9bd8d0; color:#095c57; }
.photo-sunset { background:#f3b3a1; color:#723b32; }
.photo-forest { background:#b7d4a6; color:#35552d; }
.profile-layout { display:grid; grid-template-columns:minmax(250px,.75fr) minmax(0,1.5fr); gap:20px; align-items:start; }
.profile-card { background:white; border:1px solid var(--line); border-radius:var(--radius); padding:24px; margin-bottom:20px; }
.profile-card h2 { font-size:20px; margin-bottom:18px; }
.profile-photo { width:88px; height:88px; display:grid; place-items:center; border-radius:50%; font-family:'Space Grotesk'; font-size:36px; font-weight:700; }
.profile-photo-note,.profile-email { display:block; margin-top:10px; color:var(--muted); font-size:12px; }
.profile-form { display:grid; gap:9px; margin-top:22px; }
.profile-form label { margin-top:7px; font-size:13px; font-weight:700; }
.profile-form input,.profile-form select { width:100%; min-height:44px; padding:10px 12px; border:1px solid var(--line); border-radius:9px; background:white; color:var(--ink); font:inherit; }
.profile-form button { margin-top:8px; }
.profile-message { padding:12px 15px; border-radius:9px; background:var(--mint); color:var(--teal-dark); }
.activity-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
.activity-stats > div { padding:15px; border-radius:10px; background:var(--paper); }
.activity-stats strong,.activity-stats span { display:block; }
.activity-stats strong { font-family:'Space Grotesk'; font-size:26px; }
.activity-stats span { margin-top:4px; color:var(--muted); font-size:12px; }
.saved-sessions { display:grid; gap:10px; }
.saved-session { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px; border:1px solid var(--line); border-radius:10px; }
.saved-session strong,.saved-session span { display:block; }
.saved-session strong { font-size:13px; }
.saved-session span { margin-top:5px; color:var(--muted); font-size:11px; }
.saved-session .secondary-btn { flex:none; padding:9px 12px; }
.activity-empty { margin:0; color:var(--muted); font-size:13px; }
.quiz-loading { color:var(--muted); }
@media (max-width:600px) {
  .chat-panel { max-height:calc(100vh - 32px); }
  .chat-widget .chat-messages { max-height:42vh; }
  .profile-layout { grid-template-columns:1fr; }
  .activity-stats { grid-template-columns:1fr; }
  .saved-session { align-items:flex-start; flex-direction:column; }
}

/* NextPath visual refresh based on the supplied reference screens. */
:root {
  --ink: #11141d;
  --muted: #697386;
  --paper: #f1f3f8;
  --white: #ffffff;
  --line: #dce1eb;
  --teal: #284cff;
  --teal-dark: #1738da;
  --mint: #e4eaff;
  --coral: #ff6bb4;
  --yellow: #ffe34a;
  --lavender: #eee9ff;
  --shadow: 0 16px 38px rgba(17, 20, 29, .12);
  --radius: 9px;
}
body {
  color: var(--ink);
  background: var(--paper);
  font-family: 'DM Sans', sans-serif;
}
h1, h2, h3, .brand, .stat-card strong, .admin-stat strong,
.profile-photo, .activity-stats strong, .score {
  font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
  letter-spacing: -.35px;
}
button:focus-visible, input:focus-visible, select:focus-visible,
textarea:focus-visible {
  outline: 3px solid rgba(40, 76, 255, .45);
  outline-offset: 2px;
}
.primary-btn, .secondary-btn, .banner-action {
  border-radius: 5px;
  transition: transform .18s ease, background .18s ease, box-shadow .18s ease;
}
.primary-btn {
  background: var(--teal);
  color: #fff;
}
.primary-btn:hover { background: var(--teal-dark); }
.secondary-btn {
  background: #fff;
  border-color: var(--line);
}
.eyebrow { color: var(--teal); letter-spacing: .8px; }

/* Public landing pages */
.landing { background: #fff; }
.landing-nav {
  max-width: none;
  min-height: 88px;
  padding: 18px max(32px, calc((100vw - 1280px) / 2));
  border-bottom: 1px solid rgba(255,255,255,.08);
  background: #10131a;
  color: #f6f7fb;
}
.landing-nav .brand { color: #fff; }
.brand-mark {
  border-radius: 7px;
  transform: none;
}
.nav-actions { gap: 30px; }
.landing-nav .text-btn { color: #d6d9e2; }
.landing-nav .primary-btn {
  background: var(--yellow);
  color: #11141d;
  padding: 14px 19px;
}
.landing-main {
  max-width: none;
  padding: 74px max(32px, calc((100vw - 1280px) / 2)) 66px;
  background: #10131a;
  color: #f7f8fc;
}
.hero-grid { max-width: 1280px; margin: 0 auto; gap: clamp(38px, 7vw, 100px); }
.hero .eyebrow { color: var(--yellow); }
.hero h1 {
  max-width: 660px;
  margin: 22px 0 24px;
  font-size: clamp(58px, 7vw, 96px);
  line-height: .9;
  letter-spacing: -.8px;
  font-weight: 800;
}
.hero h1 em { color: var(--yellow); }
.hero-copy { max-width: 600px; color: #aeb5c5; font-size: 17px; }
.hero-actions { gap: 12px; }
.hero-actions .primary-btn {
  background: var(--teal);
  padding: 15px 20px;
}
.hero-actions .secondary-btn {
  background: #fff;
  color: var(--ink);
  border: 0;
  padding: 15px 20px;
}
.hero-note { color: #aeb5c5; }
.avatar { border-color: #10131a; }
.hero-art { min-height: 480px; }
.art-paper {
  inset: 64px 8px 8px 24px;
  background: var(--coral);
  border-radius: 5px;
  transform: rotate(3deg);
}
.art-card {
  border: 0;
  border-radius: 10px;
  box-shadow: 0 18px 38px rgba(0,0,0,.24);
}
.art-main {
  top: 35px;
  left: 12px;
  width: min(440px, 86%);
  min-height: 355px;
  padding: 25px;
  background: linear-gradient(145deg, #3155ff, #193de7);
  color: #fff;
  transform: rotate(0);
}
.art-label { color: #dfe5ff; text-transform: uppercase; font-size: 10px; letter-spacing: .4px; }
.art-main h3 { margin: 18px 0 24px; font-size: 29px; }
.fake-bars { gap: 12px; padding: 20px 0; }
.fake-bars span { height: 12px; border-radius: 99px; background: rgba(255,255,255,.16); }
.fake-bars span:nth-child(1) { width: 90%; background: var(--yellow); }
.fake-bars span:nth-child(2) { width: 70%; background: rgba(255,255,255,.35); }
.fake-bars span:nth-child(3) { width: 80%; background: rgba(255,255,255,.22); }
.mini-line b { background: var(--yellow); }
.mini-line b:nth-child(2) { background: var(--coral); }
.mini-line b:nth-child(3) { background: #fff; }
.path-circle {
  z-index: 1;
  top: 8px;
  right: 5px;
  width: 72px;
  height: 72px;
  background: var(--yellow);
  color: var(--ink);
}
.art-mini {
  z-index: 2;
  right: 0;
  bottom: 20px;
  width: 235px;
  padding: 18px;
  transform: rotate(-4deg);
  border: 5px solid #fff;
  background: #fff;
  color: var(--ink);
}
.art-mini .art-label { color: var(--muted); }
.feature-strip {
  max-width: none;
  padding: 24px max(32px, calc((100vw - 1280px) / 2)) 55px;
  gap: 0;
  background: var(--yellow);
}
.feature {
  min-height: 82px;
  padding: 12px 22px;
  border: 0;
  border-right: 1px solid rgba(17,20,29,.18);
  color: var(--ink);
}
.feature:first-child { padding-left: 0; }
.feature:last-child { border-right: 0; }
.feature-icon, .feature:nth-child(2) .feature-icon,
.feature:nth-child(3) .feature-icon {
  color: var(--teal);
  background: transparent;
}
.feature h3 { font-size: 21px; letter-spacing: 0; }
.feature p { color: #373d4a; }
.about-grid { gap: clamp(30px, 7vw, 100px); align-items: center; }
.about-copy h1 { font-size: clamp(42px, 5vw, 66px); line-height: .98; }
.about-copy p { color: var(--muted); }
.about-point {
  border: 0;
  border-top: 1px solid var(--line);
  border-radius: 0;
  padding: 19px 0;
}
.about-point span { border-radius: 4px; background: var(--yellow); color: var(--ink); }
.about-point:nth-child(2) span { background: #ffe6f2; }
.about-point:nth-child(3) span { background: var(--mint); }

/* Sign-in and registration */
.auth-wrap {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  background: #fff;
}
.auth-side {
  order: 2;
  min-height: 100vh;
  padding: 44px clamp(30px, 5vw, 72px);
  background: #10131a;
  color: #fff;
}
.auth-side .brand-mark { background: var(--teal); }
.auth-side h1 { font-size: clamp(46px, 5vw, 72px); line-height: .92; letter-spacing: -.4px; }
.auth-side p { color: #b5bdce; }
.auth-side .side-art { color: var(--yellow); }
.auth-form-wrap { order: 1; padding: 54px 34px; background: #fff; }
.auth-form { width: min(460px, 100%); }
.auth-form h2 { font-size: 48px; line-height: .98; }
.auth-form > p { line-height: 1.6; }
.form-field input, .profile-form input, .profile-form select,
.admin-inline-form input, .admin-inline-form select,
.admin-form-grid input, .admin-form-grid textarea, .admin-form-grid select,
.admin-users-table select, .admin-settings-form input:not([type=checkbox]),
.search-box, .filter-select, .chat-form textarea {
  border-color: #dbe0eb;
  border-radius: 5px;
  box-shadow: none;
}
.form-field input { min-height: 50px; }
.form-submit { min-height: 48px; }
.form-switch button, .link-btn, .back-link { color: var(--teal); }
.error { color: #dc3d45; }

/* Signed-in workspace */
.app-shell {
  grid-template-columns: 224px minmax(0, 1fr);
  background: var(--paper);
}
.sidebar {
  background: #10131a;
  border-right: 0;
  color: #fff;
  padding: 22px 14px;
}
.sidebar .brand { padding: 0 10px 34px; color: #fff; }
.sidebar .brand-mark { background: var(--teal); }
.nav-list { gap: 7px; }
.nav-item {
  min-height: 42px;
  border-radius: 5px;
  color: #aeb5c5;
  font-size: 13px;
}
.nav-item:hover, .nav-item.active {
  background: var(--teal);
  color: #fff;
}
.target-nav-icon {
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
  color: #fff;
}
.sidebar-footer { border-top-color: rgba(255,255,255,.12); }
.sidebar-footer .user-info span { color: #aeb5c5; }
.sidebar-footer .text-btn { color: #d6d9e2; }
.user-dot { border-radius: 7px; }
.main-content { max-width: none; padding: 25px clamp(22px, 4vw, 58px) 48px; }
.topbar { margin-bottom: 30px; }
.topbar-note { color: var(--muted); }
.view-heading { margin-bottom: 22px; }
.view-heading h1 { font-size: clamp(34px, 4vw, 48px); line-height: .98; }
.view-heading p { color: var(--muted); }
.welcome-banner {
  min-height: 205px;
  padding: 30px 34px;
  border-radius: 7px;
  background: var(--teal);
}
.welcome-banner h1 { font-size: 42px; line-height: .98; }
.welcome-banner p { color: #dfe5ff; }
.banner-action { background: var(--yellow); color: var(--ink); border-radius: 4px; }
.stat-grid { gap: 12px; }
.stat-card {
  border: 0;
  border-radius: 6px;
  padding: 20px;
  background: #fff;
  box-shadow: 0 3px 12px rgba(17,20,29,.035);
}
.stat-card:nth-child(2) { background: #fff5bc; }
.stat-card:nth-child(3) { background: #ffe8f3; }
.stat-icon { color: var(--teal); }
.stat-card strong { font-size: 38px; }
.section-title h2 { font-size: 28px; letter-spacing: 0; }
.course-grid { gap: 14px; }
.course-card {
  border: 1px solid var(--line);
  border-radius: 6px;
  box-shadow: none;
}
.course-card:hover { box-shadow: var(--shadow); }
.course-color { height: 8px; background: var(--teal); }
.course-card:nth-child(4n + 2) .course-color { background: var(--yellow); }
.course-card:nth-child(4n + 3) .course-color { background: var(--coral); }
.course-card:nth-child(4n + 4) .course-color { background: #a9baff; }
.course-card-body { padding: 18px; }
.category { color: var(--teal); }
.course-card h3 { font-size: 23px; letter-spacing: 0; }
.pill { border-radius: 3px; background: var(--paper); }
.card-foot { border-top-color: var(--line); }
.arrow { color: var(--teal); }
.explorer-tools { gap: 10px; }
.search-box { background: #fff; }
.filter-select { background: #fff; }
.detail-hero, .detail-panel, .profile-card, .admin-stat {
  border: 1px solid var(--line);
  border-radius: 6px;
  box-shadow: 0 3px 12px rgba(17,20,29,.035);
}
.detail-hero h1 { font-size: 48px; }
.detail-hero-content { min-width: 0; }
.detail-panel li svg { color: var(--teal); }
.tag-list span { border-radius: 3px; background: var(--mint); color: var(--teal); }
.career-list li:before { color: var(--coral); }
.match-card { background: #10131a; color: #fff; }
.match-card p { color: #b5bdce; }
.match-card .primary-btn { background: var(--yellow); color: var(--ink); }

/* Course Match, profile, admin, and assistant */
.quiz-intro {
  border-radius: 6px;
  padding: 22px 24px;
  background: #ffe7f2;
}
.quiz-intro svg { color: var(--teal); }
.quiz-intro h3 { font-size: 24px; }
.quiz-progress span { border-radius: 0; }
.quiz-progress span.done, .quiz-progress span.current { background: var(--teal); }
.quiz-box {
  border: 1px solid var(--line);
  border-radius: 7px;
  box-shadow: 0 5px 20px rgba(17,20,29,.045);
}
.quiz-box h2 { font-size: 34px; line-height: 1.05; }
.answer {
  border-radius: 5px;
  background: #f4f5f8;
  font-weight: 500;
}
.answer:hover, .answer.selected { border-color: var(--teal); background: var(--mint); }
.result-card { border: 1px solid var(--line); border-radius: 6px; }
.result-card h3 { font-size: 25px; }
.score { color: var(--teal); }
.profile-card { padding: 22px; }
.profile-card h2 { font-size: 26px; }
.profile-photo { border-radius: 7px; }
.profile-message { border-radius: 5px; background: var(--mint); color: #1837bd; }
.activity-stats > div { border-radius: 5px; background: var(--paper); }
.saved-session { border-color: var(--line); border-radius: 5px; }
.admin-stat > span { border-radius: 5px; background: var(--mint); color: var(--teal); }
.admin-stat strong { font-size: 38px; }
.admin-registration-list > div { border-radius: 4px; }
.admin-inline-form, .admin-course-form, .admin-settings-form {
  border-color: var(--line);
  border-radius: 6px;
  background: #f8f9fc;
}
.admin-users-table th, .admin-users-table td { border-bottom-color: var(--line); }
.admin-role { border-radius: 4px; background: var(--mint); }
.admin-role.is-admin { background: #fff1aa; color: #5e4b00; }
.chat-panel { border-radius: 8px; }
.chat-widget-header { background: #10131a; }
.chat-widget-title span { color: #b5bdce; }
.chat-message { border-radius: 6px; background: #f1f3f8; }
.chat-message.user { background: var(--mint); }
.chat-role { color: var(--teal); }
.chat-suggestion { border-radius: 4px; color: var(--teal); }
.chat-suggestion:hover { border-color: var(--teal); background: var(--mint); }
.toast { border-radius: 5px; }

@media (max-width: 900px) {
  .landing-nav { padding: 18px 24px; }
  .landing-main { padding: 54px 24px 46px; }
  .hero-art { min-height: 390px; }
  .feature-strip { padding: 20px 24px 42px; }
  .auth-side { min-height: 360px; }
  .app-shell { grid-template-columns: 1fr; }
  .sidebar { background: #10131a; }
}
@media (max-width: 600px) {
  .landing-nav { min-height: 72px; padding: 15px 18px; }
  .landing-nav .brand { font-size: 19px; }
  .landing-nav .primary-btn { padding: 11px 12px; }
  .landing-main { padding: 44px 20px 34px; }
  .hero h1 { font-size: clamp(52px, 14vw, 72px); }
  .hero-copy { font-size: 15px; }
  .hero-actions { align-items: stretch; }
  .hero-art { min-height: 300px; transform: none; margin: 0 auto -8px; }
  .art-main { top: 18px; left: 0; width: 88%; min-height: 230px; padding: 18px; }
  .art-main h3 { font-size: 24px; margin: 12px 0; }
  .fake-bars { gap: 8px; padding: 8px 0; }
  .art-mini { width: 190px; bottom: 5px; }
  .path-circle { right: 0; width: 56px; height: 56px; }
  .feature-strip { grid-template-columns: 1fr; padding: 16px 20px 30px; }
  .feature, .feature:first-child { padding: 13px 0; border-right: 0; border-bottom: 1px solid rgba(17,20,29,.18); }
  .feature:last-child { border-bottom: 0; }
  .auth-wrap { grid-template-columns: 1fr; }
  .auth-side { order: 1; min-height: 250px; padding: 25px 24px; gap: 28px; }
  .auth-side h1 { font-size: 42px; }
  .auth-side .side-art { display: none; }
  .auth-form-wrap { order: 2; padding: 36px 22px; }
  .auth-form h2 { font-size: 40px; }
  .sidebar { left: -250px; width: 238px; }
  .main-content { padding: 17px 15px 32px; }
  .welcome-banner { min-height: 0; padding: 22px; }
  .welcome-banner h1 { font-size: 34px; }
  .view-heading h1 { font-size: 37px; }
  .quiz-box h2 { font-size: 28px; }
  .detail-hero-content { width: 100%; }
  .detail-hero h1 { font-size: clamp(30px, 8vw, 42px); }
}

.quiz-box:not(.course-match-results-chat) { animation: course-match-enter .24s ease-out; }
.quiz-progress span { transition: background-color .2s ease; }
.answer { transition: border-color .2s ease, background-color .2s ease, transform .2s ease; }
.answer:hover { transform: translateY(-1px); }
.quiz-footer .primary-btn:disabled { opacity: .55; cursor: not-allowed; }
.course-match-results { max-width: 980px; margin: 0 auto; }
.course-match-results > .result-head { padding: 27px 24px; border-radius: 8px; background: linear-gradient(130deg, #eef2ff, #f8efff); }
.course-match-results > .result-head h2 { margin: 8px 0; color: var(--ink); font-size: clamp(26px, 4vw, 38px); }
.course-match-results > .result-head p { margin: 0; }
.course-match-results > .why-courses-match { padding: 3px 14px; background: transparent; text-align: left; }
.other-course-results, .why-courses-match, .explore-course-results { margin-top: 25px; }
.other-course-results > h2 { margin: 0 0 12px; font-size: 22px; }
.course-match-summary-list { display: grid; gap: 9px; }
.course-match-summary { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 15px 18px; border: 1px solid var(--line); border-radius: 7px; background: #fff; }
.course-match-summary h3 { margin: 0; font-size: 17px; }
.course-match-summary .score { font-size: 17px; }
.why-courses-match .eyebrow, .explore-course-results .eyebrow { display: inline-block; margin-bottom: 12px; }
.course-match-explanations { display: grid; gap: 10px; }
.course-match-explanations article { padding: 14px 17px; border-left: 3px solid #6b63d9; border-radius: 4px; background: #f7f6ff; }
.course-match-explanations h3 { margin: 0 0 6px; font-size: 16px; }
.course-match-explanations p, .explore-course-results > p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.6; }
.explore-course-results > p { margin: 0 0 14px; }
.result-card-list { display: grid; gap: 16px; }
.result-card.course-match-result-card { display: block; margin: 0; padding: 23px; border: 1px solid var(--line); border-left: 4px solid #6b63d9; border-radius: 8px; }
.result-card.course-match-result-card:first-child { border: 2px solid #6558d9; background: linear-gradient(135deg, #fff, #f8f6ff); }
.result-course-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.result-course-heading .category { color: #594bc6; font-weight: 700; }
.result-course-heading .score { white-space: nowrap; font-size: 19px; }
.recommendation-rank { color: #594bc6; font-size: 13px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; }
.result-card.course-match-result-card h3 { margin: 12px 0 8px; }
.result-course-description { margin-bottom: 15px !important; }
.result-card.course-match-result-card > p { line-height: 1.65; }
.result-card.course-match-result-card > p strong { color: var(--ink); }
.personalized-match-reason { margin: 14px 0; }
.matching-evidence { margin: 15px 0; }
.matching-evidence > strong { display: block; margin-bottom: 8px; font-size: 13px; }
.match-evidence-tags { display: flex; flex-wrap: wrap; gap: 7px; }
.match-evidence-tags span { max-width: 100%; padding: 6px 10px; border: 1px solid rgba(99, 102, 241, .14); border-radius: 999px; background: rgba(238, 242, 255, .76); color: #393c72; font-size: 12px; line-height: 1.45; overflow-wrap: anywhere; }
.matching-evidence-empty { margin: 14px 0; color: var(--muted); font-size: 13px; }
.match-factor-scores { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9px; margin: 16px 0; }
.match-factor-scores > div { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 12px; border-radius: 8px; background: rgba(241, 243, 255, .82); color: var(--muted); font-size: 12px; }
.match-factor-scores strong { color: var(--ink); white-space: nowrap; }
.result-course-details { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin: 20px 0; }
.result-course-details > div { padding: 14px; border-radius: 6px; background: #f5f6fb; }
.result-course-details strong { font-size: 13px; }
.result-course-details ul { margin: 8px 0 0; padding-left: 18px; color: var(--muted); font-size: 13px; line-height: 1.6; }
.compatibility-note { margin: 15px 4px 26px; color: var(--muted); font-size: 12px; line-height: 1.6; }
.course-match-results-chat { max-width: 980px; margin-top: 20px; }
.results-chat-heading { padding: 23px 24px 18px; background: linear-gradient(120deg, #f1f3ff, #f9f2ff); }
.results-chat-heading h2 { margin: 7px 0; font-size: 23px; }
.results-chat-heading p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.5; }
.course-match-results-chat .chat-messages { min-height: 160px; max-height: 420px; }
.course-match-results-chat .chat-notice { padding-top: 12px; }
.retake-course-match { display: flex; justify-content: center; margin: 24px 0 8px; }
.quiz-generating { text-align: center; }
.loading-spinner { width: 34px; height: 34px; margin: 4px auto 18px; border: 3px solid #e5e2fb; border-top-color: #6558d9; border-radius: 50%; animation: course-match-spin .8s linear infinite; }
.quiz-generating p { color: var(--muted); line-height: 1.6; }
@keyframes course-match-enter { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
@keyframes course-match-spin { to { transform: rotate(360deg); } }
@media (max-width: 700px) {
  .result-course-details { grid-template-columns: 1fr; }
  .match-factor-scores { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .result-card.course-match-result-card { padding: 18px; }
  .result-course-heading { align-items: flex-start; flex-direction: column; gap: 5px; }
  .course-match-results-chat .chat-messages { padding: 16px; }
  .course-match-results-chat .chat-form { align-items: stretch; flex-direction: column; padding: 14px; }
  .course-match-results-chat .chat-form button { justify-content: center; min-height: 44px; }
}
@media (prefers-reduced-motion: reduce) {
  .quiz-box:not(.course-match-results-chat), .loading-spinner { animation: none; }
  .answer, .quiz-progress span { transition: none; }
}

.main-content:has(.explorer-page),
.main-content:has(.course-match-page) {
  background: linear-gradient(135deg, #DBEAFE 0%, #EDE9FE 55%, #FCE7F3 100%);
}
.app-shell:has(.explorer-page) .nav-item.active,
.app-shell:has(.course-match-page) .nav-item.active {
  background: linear-gradient(110deg, #4361EE, #7C3AED);
  color: #fff;
  box-shadow: 0 5px 14px rgba(67, 97, 238, .2);
}
.course-page { width: 100%; min-width: 0; }
.course-page .view-heading {
  align-items: flex-start;
  margin-bottom: 22px;
}
.course-page .view-heading > div { max-width: 820px; }
.course-page .view-heading .eyebrow {
  color: #5146ca;
  letter-spacing: .9px;
}
.course-page .view-heading h1 {
  margin-top: 6px;
  color: #111827;
  font-family: 'DM Sans', sans-serif;
  font-size: clamp(36px, 4vw, 48px);
  font-weight: 800;
  letter-spacing: -1.5px;
  line-height: 1.08;
}
.course-page .view-heading p {
  margin-top: 10px;
  color: #536789;
  font-size: 15px;
  line-height: 1.6;
}
.gradient-heading-text {
  background: linear-gradient(100deg, #4361EE 0%, #7C3AED 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.explorer-page .view-heading h1 { color: #111827; }
.explorer-page .explorer-tools { gap: 12px; margin-bottom: 18px; }
.explorer-page .search-box,
.explorer-page .filter-select {
  min-height: 44px;
  border: 1px solid rgba(126, 145, 190, .25);
  border-radius: 10px;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 4px 14px rgba(74, 91, 145, .08);
  transition: border-color .18s ease, box-shadow .18s ease;
}
.explorer-page .search-box { padding: 0 13px; }
.explorer-page .search-box:focus-within,
.explorer-page .filter-select:focus {
  border-color: #7C3AED;
  box-shadow: 0 0 0 3px rgba(124, 58, 237, .13);
  outline: none;
}
.explorer-page .search-box input { min-width: 0; }
.explorer-page .course-view-options {
  gap: 8px;
  margin: 18px 0 20px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.explorer-page .course-view-option {
  min-height: 42px;
  padding: 10px 16px;
  border-radius: 9px;
  background: rgba(255, 255, 255, .76);
  color: #28334d;
  box-shadow: 0 3px 12px rgba(74, 91, 145, .07);
}
.explorer-page .course-view-option.active {
  background: linear-gradient(110deg, #4361EE, #7C3AED);
  color: #fff;
  box-shadow: 0 7px 16px rgba(84, 74, 220, .2);
}
.explorer-page .course-sort-control .filter-select { padding: 0 12px; }
.explorer-page .course-results-summary { color: #536789; }
.explorer-page .course-results-summary strong { color: #111827; }
.explorer-page .course-card {
  border-color: rgba(126, 145, 190, .2);
  border-radius: 12px;
  box-shadow: 0 6px 18px rgba(74, 91, 145, .09);
  transition: transform .2s ease, box-shadow .2s ease;
}
.explorer-page .course-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 24px rgba(74, 91, 145, .14);
}
.explorer-page .course-card-body { padding: 19px; }
.explorer-page .course-card h3 {
  color: #17213a;
  font-family: 'DM Sans', sans-serif;
  font-size: 20px;
  font-weight: 750;
  letter-spacing: -.45px;
}
.explorer-page .course-card p { color: #536789; }
.explorer-page .pill {
  border: 1px solid rgba(124, 58, 237, .08);
  border-radius: 6px;
  background: #F1F0FF;
  color: #5146ca;
}
.explorer-page .course-sort-control,
.explorer-page .course-results-summary,
.explorer-page .course-count { color: #536789; }
.explorer-page .clear-course-filters,
.explorer-page #back-categories,
.explorer-page .load-more-container .secondary-btn {
  border-color: rgba(126, 145, 190, .28);
  border-radius: 9px;
  background: rgba(255, 255, 255, .9);
}
.course-match-page .view-heading { max-width: 820px; margin-right: auto; margin-left: auto; }
.course-match-page .quiz-box:not(.course-match-results-chat) {
  max-width: 820px;
  margin: 0 auto;
  padding: clamp(23px, 4vw, 36px);
  border: 1px solid rgba(124, 58, 237, .12);
  border-radius: 18px;
  background: linear-gradient(145deg, #fff 0%, #FBFAFF 100%);
  box-shadow: 0 16px 38px rgba(76, 69, 150, .13);
}
.quiz-progress-copy {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 9px;
  color: #5146ca;
  font-size: 13px;
}
.quiz-progress-copy strong { color: #25304a; }
.quiz-progress {
  display: block;
  height: 9px;
  margin: 0;
  overflow: hidden;
  border-radius: 999px;
  background: #E9E7F5;
}
.course-match-page .quiz-progress .quiz-progress-fill {
  display: block;
  flex: none;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #4361EE 0%, #7C3AED 100%);
  transition: width .35s ease;
}
.quiz-motivation {
  margin: 15px 0 27px;
  padding: 11px 14px;
  border: 1px solid rgba(124, 58, 237, .08);
  border-radius: 9px;
  background: linear-gradient(100deg, #F0EDFF, #F8F3FF);
  color: #5146ca;
  font-size: 13px;
  font-weight: 600;
}
.course-match-page .quiz-box h2 {
  margin: 0 0 19px;
  color: #17213a;
  font-family: 'DM Sans', sans-serif;
  font-size: clamp(22px, 3vw, 28px);
  font-weight: 750;
  letter-spacing: -.6px;
  line-height: 1.28;
}
.course-match-page .answer-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
.course-match-page .answer {
  position: relative;
  min-height: 66px;
  padding: 15px 43px 15px 16px;
  border: 1px solid rgba(113, 127, 165, .2);
  border-radius: 11px;
  background: #EFF6FF;
  color: #293650;
  font-size: 14px;
  line-height: 1.45;
  transition: transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease;
}
.course-match-page .answer:nth-child(4n + 2) { background: #F3EFFF; }
.course-match-page .answer:nth-child(4n + 3) { background: #FFF0F7; }
.course-match-page .answer:nth-child(4n + 4) { background: #FFF5E8; }
.course-match-page .answer:hover {
  transform: translateY(-2px);
  border-color: rgba(124, 58, 237, .4);
  box-shadow: 0 6px 15px rgba(74, 67, 145, .08);
}
.course-match-page .answer.selected {
  border: 2px solid #7C3AED;
  background: #F0EDFF;
  box-shadow: 0 0 0 3px rgba(124, 58, 237, .08);
}
.course-match-page .answer.selected::after {
  position: absolute;
  top: 10px;
  right: 12px;
  display: grid;
  width: 20px;
  height: 20px;
  place-items: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #4361EE, #7C3AED);
  color: #fff;
  content: "✓";
  font-size: 12px;
  font-weight: 800;
}
.course-match-page .quiz-footer { gap: 12px; }
.course-match-page .quiz-footer .primary-btn,
.course-match-page .course-match-results .primary-btn,
.course-match-page .course-match-results-chat .chat-form .primary-btn,
.course-match-page .view-heading .primary-btn {
  border: 0;
  border-radius: 9px;
  background: linear-gradient(110deg, #4361EE, #7C3AED);
  box-shadow: 0 6px 15px rgba(84, 74, 220, .18);
}
.course-match-page .quiz-footer .primary-btn:hover,
.course-match-page .course-match-results .primary-btn:hover,
.course-match-page .course-match-results-chat .chat-form .primary-btn:hover,
.course-match-page .view-heading .primary-btn:hover {
  background: linear-gradient(110deg, #3654DF, #6D28D9);
  box-shadow: 0 9px 18px rgba(84, 74, 220, .24);
}
.course-match-page .quiz-footer .secondary-btn,
.course-match-page .retake-course-match .secondary-btn {
  border: 1px solid rgba(126, 145, 190, .28);
  border-radius: 9px;
  background: #fff;
}
.course-match-page .course-match-results > .result-head,
.course-match-page .results-chat-heading {
  border: 1px solid rgba(124, 58, 237, .1);
  border-radius: 14px;
  background: linear-gradient(130deg, rgba(219, 234, 254, .82), rgba(237, 233, 254, .84), rgba(252, 231, 243, .76));
}
.course-match-page .result-card.course-match-result-card {
  border-color: rgba(124, 58, 237, .14);
  border-radius: 14px;
  background: rgba(255, 255, 255, .95);
  box-shadow: 0 7px 20px rgba(74, 91, 145, .08);
}
.course-match-page .result-card.course-match-result-card:first-child {
  border: 2px solid rgba(124, 58, 237, .42);
  background: linear-gradient(145deg, #fff, #F8F6FF);
}
.course-match-page .course-match-summary {
  border-color: rgba(124, 58, 237, .12);
  border-radius: 11px;
  background: rgba(255, 255, 255, .86);
}
.course-match-page .course-match-explanations article {
  border-left-color: #7C3AED;
  border-radius: 8px;
  background: rgba(255, 255, 255, .77);
}
.course-match-page .result-course-details > div {
  border-radius: 9px;
  background: linear-gradient(135deg, #F2F4FF, #FAF7FF);
}
.course-match-page .course-match-results-chat {
  margin-right: auto;
  margin-left: auto;
  border-color: rgba(124, 58, 237, .12);
  border-radius: 16px;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 10px 26px rgba(74, 91, 145, .1);
}
.course-match-page .results-chat-heading {
  margin: 0 0 12px;
  border: 0;
  border-bottom: 1px solid rgba(124, 58, 237, .1);
  border-radius: 16px 16px 0 0;
}
.course-match-page .retake-course-match { margin-top: 24px; }

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}
.explorer-tools { flex-wrap: wrap; }
.explorer-tools .search-box { flex: 1 1 280px; max-width: none; }
.explorer-tools .filter-select { min-height: 44px; }
.clear-course-filters { min-height: 44px; white-space: nowrap; }
.course-view-options {
  display: flex;
  gap: 8px;
  margin: 18px 0;
  padding: 5px;
  width: fit-content;
  max-width: 100%;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #f7f8fc;
}
.course-view-option {
  padding: 10px 16px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--muted);
  font: inherit;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: background .2s, color .2s, box-shadow .2s;
}
.course-view-option.active {
  background: white;
  color: #5146ca;
  box-shadow: 0 2px 8px rgba(37, 42, 91, .1);
}
.course-sort-control {
  display: flex;
  align-items: center;
  gap: 10px;
  width: fit-content;
  margin: 0 0 14px auto;
  color: var(--muted);
  font-size: 13px;
}
.course-sort-control .filter-select { min-height: 42px; }
.course-results-summary {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin: 0 0 14px;
  color: var(--muted);
  font-size: 13px;
}
.course-results-summary[hidden] { display: none; }
.course-results-summary strong { color: var(--ink); }
.load-more-container { display: flex; justify-content: center; margin: 22px 0 4px; }
.load-more-container[hidden] { display: none; }
.course-duration { margin-top: 16px !important; }
.course-duration strong { color: var(--ink); }
.detail-hero h1 small { color: var(--muted); font-size: .55em; }
.related-course-list { display: flex; flex-wrap: wrap; gap: 8px; }
.related-course-list .secondary-btn { padding: 9px 12px; }
@media (max-width: 1050px) {
  .category-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (max-width: 760px) {
  .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .explorer-tools { align-items: stretch; }
  .explorer-tools .search-box { flex-basis: 100%; }
  .explorer-tools .filter-select { flex: 1 1 180px; }
  .explorer-tools .clear-course-filters { flex: 1 1 auto; }
  .view-heading:has(> button) { align-items: flex-start; flex-direction: column; }
  .course-match-page .quiz-footer { flex-wrap: wrap; }
  .course-match-page .quiz-footer .step-label { order: 1; width: 100%; text-align: center; }
}
@media (max-width: 480px) {
  .category-grid { grid-template-columns: 1fr; }
  .category-card { padding: 18px; }
  .course-view-options { display: grid; width: 100%; grid-template-columns: 1fr 1fr; }
  .course-view-option { padding: 10px 8px; font-size: 13px; }
  .course-sort-control { justify-content: space-between; width: 100%; margin-left: 0; }
  .course-results-summary { flex-direction: column; gap: 4px; }
  .course-match-page .view-heading h1 { font-size: 34px; }
  .course-match-page .quiz-box:not(.course-match-results-chat) { padding: 20px 16px; }
  .course-match-page .answer-grid { grid-template-columns: 1fr; }
  .course-match-page .quiz-footer .secondary-btn,
  .course-match-page .quiz-footer .primary-btn { min-height: 42px; }
}

/* Shared pastel theme for pages outside the Explore Courses reference view. */
:root {
  --page-gradient: linear-gradient(135deg, #DBEAFE 0%, #EDE9FE 55%, #FCE7F3 100%);
  --brand-blue: #4361EE;
  --brand-purple: #7C3AED;
  --category-blue: #2782F3;
  --category-orange: #F59E0B;
  --category-purple: #8B3FF2;
  --category-pink: #EC4899;
  --category-green: #10B981;
  --category-coral: #F06A67;
  --category-teal: #14B8A6;
  --category-indigo: #6254F5;
  --category-blue-pastel: #DBEAFE;
  --category-orange-pastel: #FFF1D6;
  --category-purple-pastel: #EDE9FE;
  --category-pink-pastel: #FCE7F3;
  --category-green-pastel: #DDF8EE;
  --category-coral-pastel: #FFE9E6;
  --category-teal-pastel: #DDF8F5;
  --category-indigo-pastel: #E8E8FF;
  --pastel-lavender: #EDE9FE;
  --pastel-pink: #FCE7F3;
  --shared-card-shadow: 0 8px 22px rgba(67, 82, 145, .10);
}
body,
.landing,
.auth-wrap,
.auth-form-wrap,
.main-content {
  background: var(--page-gradient);
}
.main-content { min-width: 0; }
.main-content:has(.explorer-page),
.main-content:has(.course-match-page) {
  background: var(--page-gradient);
}
.auth-wrap { background-color: transparent; }
.auth-side { background: #111827; }
.auth-side .brand-mark { background: linear-gradient(135deg, var(--brand-blue), var(--brand-purple)); }
.app-shell .sidebar,
.app-shell .sidebar .brand,
.app-shell .sidebar .nav-item,
.app-shell .sidebar .nav-item:hover,
.app-shell .sidebar .nav-item.active {
  background-color: #111827;
}
.app-shell .sidebar { border-right-color: rgba(255, 255, 255, .08); }
.app-shell .sidebar .nav-item:hover {
  background: rgba(255, 255, 255, .09);
  color: #fff;
}
.app-shell .sidebar .nav-item.active {
  background: linear-gradient(110deg, var(--brand-blue), var(--brand-purple));
  color: #fff;
}
.main-content:not(:has(.explorer-page)) .primary-btn,
.auth-form .primary-btn,
.chat-panel .chat-form .primary-btn {
  border: 0;
  background: linear-gradient(110deg, var(--brand-blue), var(--brand-purple));
  box-shadow: 0 6px 15px rgba(84, 74, 220, .16);
}
.main-content:not(:has(.explorer-page)) .primary-btn:hover,
.auth-form .primary-btn:hover,
.chat-panel .chat-form .primary-btn:hover {
  background: linear-gradient(110deg, #3654DF, #6D28D9);
  box-shadow: 0 9px 18px rgba(84, 74, 220, .22);
}
.main-content:not(:has(.explorer-page)) .eyebrow,
.auth-form .eyebrow { color: #5146ca; }
.main-content:not(:has(.explorer-page)) h1,
.main-content:not(:has(.explorer-page)) h2,
.main-content:not(:has(.explorer-page)) h3,
.auth-form h2 {
  font-family: 'DM Sans', sans-serif;
  letter-spacing: -.55px;
}
.main-content:not(:has(.explorer-page)) button:focus-visible,
.main-content:not(:has(.explorer-page)) input:focus-visible,
.main-content:not(:has(.explorer-page)) select:focus-visible,
.main-content:not(:has(.explorer-page)) textarea:focus-visible,
.auth-wrap button:focus-visible,
.auth-wrap input:focus-visible {
  outline: 3px solid rgba(124, 58, 237, .4);
  outline-offset: 2px;
}
.main-content:not(:has(.explorer-page)) .welcome-banner {
  border: 0;
  border-radius: 15px;
  background: linear-gradient(110deg, #4361EE 0%, #6254E8 52%, #7C3AED 100%);
  box-shadow: 0 12px 26px rgba(79, 74, 201, .2);
}
.main-content:not(:has(.explorer-page)) .welcome-banner::after { display: none; }
.main-content:not(:has(.explorer-page)) .welcome-banner h1 {
  color: #fff;
  font-family: 'DM Sans', sans-serif;
  font-weight: 800;
  letter-spacing: -1px;
}
.main-content:not(:has(.explorer-page)) .welcome-banner p { color: #eef0ff; }
.main-content:not(:has(.explorer-page)) .welcome-banner .eyebrow { color: #e0e7ff !important; }
.main-content:not(:has(.explorer-page)) .banner-action {
  border: 1px solid rgba(255, 255, 255, .32);
  border-radius: 10px;
  background: rgba(255, 255, 255, .16);
  color: #fff;
  backdrop-filter: blur(8px);
}
.main-content:not(:has(.explorer-page)) .banner-action:hover {
  background: rgba(255, 255, 255, .25);
  box-shadow: 0 8px 18px rgba(30, 34, 100, .2);
}
.main-content:not(:has(.explorer-page)) .stat-card,
.main-content:not(:has(.explorer-page)) .profile-card,
.main-content:not(:has(.explorer-page)) .detail-hero,
.main-content:not(:has(.explorer-page)) .detail-panel,
.main-content:not(:has(.explorer-page)) .admin-stat,
.main-content:not(:has(.explorer-page)) .admin-course-list > div,
.main-content:not(:has(.explorer-page)) .activity-stats > div,
.main-content:not(:has(.explorer-page)) .saved-session,
.main-content:not(:has(.explorer-page)) .admin-registration-list > div,
.main-content:not(:has(.explorer-page)) .course-match-summary,
.main-content:not(:has(.explorer-page)) .course-match-results > .result-head,
.main-content:not(:has(.explorer-page)) .course-match-explanations article,
.main-content:not(:has(.explorer-page)) .result-card,
.main-content:not(:has(.explorer-page)) .quiz-box:not(.course-match-results-chat),
.main-content:not(:has(.explorer-page)) .admin-chart,
.main-content:not(:has(.explorer-page)) .about-point {
  border: 1px solid rgba(125, 139, 184, .16);
  border-top: 5px solid var(--card-accent, #8B3DFF);
  border-radius: 13px;
  background: linear-gradient(145deg, var(--card-pastel, #fff) 0%, #fff 92%);
  box-shadow: var(--shared-card-shadow);
}
.main-content:not(:has(.explorer-page)) .stat-card {
  --card-accent: var(--category-blue);
  --card-pastel: #EFF6FF;
  padding: 18px 20px;
}
.main-content:not(:has(.explorer-page)) .stat-card:nth-child(3n + 2) {
  --card-accent: var(--category-purple);
  --card-pastel: #F2EEFF;
}
.main-content:not(:has(.explorer-page)) .stat-card:nth-child(3n) {
  --card-accent: var(--category-pink);
  --card-pastel: #FFF0F7;
}
.main-content:not(:has(.explorer-page)) .stat-card strong,
.main-content:not(:has(.explorer-page)) .admin-stat strong,
.main-content:not(:has(.explorer-page)) .activity-stats strong {
  color: #202b49;
}
.main-content:not(:has(.explorer-page)) .stat-icon { color: var(--brand-purple); }
.main-content:not(:has(.explorer-page)) .admin-stat {
  --card-accent: var(--category-blue);
  --card-pastel: var(--category-blue-pastel);
  padding: 16px 18px;
}
.main-content:not(:has(.explorer-page)) .admin-stat:nth-child(8n + 2) { --card-accent: var(--category-orange); --card-pastel: var(--category-orange-pastel); }
.main-content:not(:has(.explorer-page)) .admin-stat:nth-child(8n + 3) { --card-accent: var(--category-purple); --card-pastel: var(--category-purple-pastel); }
.main-content:not(:has(.explorer-page)) .admin-stat:nth-child(8n + 4) { --card-accent: var(--category-pink); --card-pastel: var(--category-pink-pastel); }
.main-content:not(:has(.explorer-page)) .admin-stat:nth-child(8n + 5) { --card-accent: var(--category-green); --card-pastel: var(--category-green-pastel); }
.main-content:not(:has(.explorer-page)) .admin-stat:nth-child(8n + 6) { --card-accent: var(--category-coral); --card-pastel: var(--category-coral-pastel); }
.main-content:not(:has(.explorer-page)) .admin-stat:nth-child(8n + 7) { --card-accent: var(--category-teal); --card-pastel: var(--category-teal-pastel); }
.main-content:not(:has(.explorer-page)) .admin-stat:nth-child(8n) { --card-accent: var(--category-indigo); --card-pastel: var(--category-indigo-pastel); }
.main-content:not(:has(.explorer-page)) .admin-stat > span {
  background: rgba(255, 255, 255, .7);
  color: var(--card-accent);
}
.main-content:not(:has(.explorer-page)) .profile-card,
.main-content:not(:has(.explorer-page)) .detail-hero,
.main-content:not(:has(.explorer-page)) .detail-panel,
.main-content:not(:has(.explorer-page)) .admin-chart {
  --card-accent: var(--brand-purple);
  --card-pastel: #F5F2FF;
}
.main-content:not(:has(.explorer-page)) .profile-card:nth-child(2n),
.main-content:not(:has(.explorer-page)) .detail-panel:nth-child(2n) {
  --card-accent: var(--category-blue);
  --card-pastel: #F0F6FF;
}
.main-content:not(:has(.explorer-page)) .activity-stats > div {
  --card-accent: var(--category-blue);
  --card-pastel: #EFF6FF;
  padding: 13px;
}
.main-content:not(:has(.explorer-page)) .activity-stats > div:nth-child(2) { --card-accent: var(--category-purple); --card-pastel: #F4F0FF; }
.main-content:not(:has(.explorer-page)) .activity-stats > div:nth-child(3) { --card-accent: var(--category-pink); --card-pastel: #FFF0F7; }
.main-content:not(:has(.explorer-page)) .saved-session {
  --card-accent: var(--brand-purple);
  --card-pastel: #F8F5FF;
  border-radius: 10px;
}
.main-content:not(:has(.explorer-page)) .admin-course-list > div {
  border: 1px solid rgba(125, 139, 184, .2);
  border-top: 1px solid rgba(125, 139, 184, .2);
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 3px 10px rgba(17, 24, 39, .04);
}
.main-content:not(:has(.explorer-page)) .admin-registration-list > div {
  --card-accent: var(--category-blue);
  --card-pastel: #EFF6FF;
  padding: 9px 4px;
  border-radius: 8px;
}
.main-content:not(:has(.explorer-page)) .admin-registration-list > div:nth-child(4n + 2) { --card-accent: var(--category-purple); --card-pastel: #F4F0FF; }
.main-content:not(:has(.explorer-page)) .admin-registration-list > div:nth-child(4n + 3) { --card-accent: var(--category-pink); --card-pastel: #FFF0F7; }
.main-content:not(:has(.explorer-page)) .admin-registration-list > div:nth-child(4n) { --card-accent: var(--category-teal); --card-pastel: #EAFBF9; }
.main-content:not(:has(.explorer-page)) .course-card {
  --card-accent: var(--category-blue);
  --card-pastel: var(--category-blue-pastel);
  border: 1px solid rgba(126, 145, 190, .13);
  border-top: 8px solid var(--card-accent);
  border-radius: 13px;
  background: linear-gradient(145deg, var(--card-pastel) 0%, rgba(255, 255, 255, .98) 88%);
  box-shadow: 0 8px 20px rgba(74, 91, 145, .12);
  transition: transform .2s ease, box-shadow .2s ease;
}
.main-content:not(:has(.explorer-page)) .course-card[data-category="technology-computing"] { --card-accent: var(--category-blue); --card-pastel: var(--category-blue-pastel); }
.main-content:not(:has(.explorer-page)) .course-card[data-category="business-management"] { --card-accent: var(--category-orange); --card-pastel: var(--category-orange-pastel); }
.main-content:not(:has(.explorer-page)) .course-card[data-category="engineering-architecture"] { --card-accent: var(--category-purple); --card-pastel: var(--category-purple-pastel); }
.main-content:not(:has(.explorer-page)) .course-card[data-category="health-medical"] { --card-accent: var(--category-pink); --card-pastel: var(--category-pink-pastel); }
.main-content:not(:has(.explorer-page)) .course-card[data-category="education"] { --card-accent: var(--category-green); --card-pastel: var(--category-green-pastel); }
.main-content:not(:has(.explorer-page)) .course-card[data-category="arts-design-communication"] { --card-accent: var(--category-coral); --card-pastel: var(--category-coral-pastel); }
.main-content:not(:has(.explorer-page)) .course-card[data-category="science-environment"] { --card-accent: var(--category-teal); --card-pastel: var(--category-teal-pastel); }
.main-content:not(:has(.explorer-page)) .course-card[data-category="social-public-service"] { --card-accent: var(--category-indigo); --card-pastel: var(--category-indigo-pastel); }
.main-content:not(:has(.explorer-page)) .course-card .course-color { display: none; }
.main-content:not(:has(.explorer-page)) .course-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 13px 25px rgba(74, 91, 145, .16);
}
.main-content:not(:has(.explorer-page)) .course-card h3 {
  color: #17213a;
  font-family: 'DM Sans', sans-serif;
  font-weight: 750;
  letter-spacing: -.4px;
}
.main-content:not(:has(.explorer-page)) .course-card .category,
.main-content:not(:has(.explorer-page)) .course-card .arrow { color: var(--card-accent); }
.main-content:not(:has(.explorer-page)) .course-card .pill {
  border: 1px solid color-mix(in srgb, var(--card-accent), white 82%);
  border-radius: 6px;
  background: color-mix(in srgb, var(--card-accent), white 92%);
  color: color-mix(in srgb, var(--card-accent), #17213a 22%);
}
.main-content:not(:has(.explorer-page)) .course-match-results > .result-head {
