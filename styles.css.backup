.main-content:not(:has(.explorer-page)) .result-card[data-category="education"] { --card-accent: var(--category-green); --card-pastel: var(--category-green-pastel); }
.main-content:not(:has(.explorer-page)) .result-card[data-category="arts-design-communication"] { --card-accent: var(--category-coral); --card-pastel: var(--category-coral-pastel); }
.main-content:not(:has(.explorer-page)) .result-card[data-category="science-environment"] { --card-accent: var(--category-teal); --card-pastel: var(--category-teal-pastel); }
.main-content:not(:has(.explorer-page)) .result-card[data-category="social-public-service"] { --card-accent: var(--category-indigo); --card-pastel: var(--category-indigo-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-results .result-card {
  border-top: 8px solid var(--card-accent);
  border-radius: 13px;
  background: linear-gradient(145deg, var(--card-pastel) 0%, rgba(255, 255, 255, .98) 88%);
  box-shadow: 0 8px 20px rgba(74, 91, 145, .12);
}
.main-content:not(:has(.explorer-page)) .course-match-explanations article {
  --card-accent: var(--brand-purple);
  --card-pastel: #F5F2FF;
}
.main-content:not(:has(.explorer-page)) .course-match-explanations article[data-category="technology-computing"] { --card-accent: var(--category-blue); --card-pastel: var(--category-blue-pastel); }
.main-content:not(:has(.explorer-page)) .course-match-explanations article[data-category="business-management"] { --card-accent: var(--category-orange); --card-pastel: var(--category-orange-pastel); }
