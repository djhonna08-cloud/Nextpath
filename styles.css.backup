  .screen.landing:has(.hero-grid) .landing-nav,
  .screen.landing:has(.hero-grid) .landing-main {
    padding-right: 4vw;
    padding-left: 4vw;
  }
  .screen.landing:has(.hero-grid) .hero-grid { gap: 3%; }
  .screen.landing:has(.hero-grid) .hero h1 {
    font-size: clamp(46px, 5.3vw, 58px);
    letter-spacing: -2.2px;
  }
  .screen.landing:has(.hero-grid) .hero { transform: none; }
  .screen.landing:has(.hero-grid) .hero-copy { font-size: 15px; }
  .screen.landing:has(.hero-grid) .hero-actions { gap: 10px; }
  .screen.landing:has(.hero-grid) .hero-actions .primary-btn,
  .screen.landing:has(.hero-grid) .hero-actions .secondary-btn {
    min-width: 0;
    flex: 1 1 0;
    min-height: 54px;
    padding: 13px 15px;
    font-size: 14px;
  }
  .screen.landing:has(.hero-grid) .hero-art { min-height: 370px; }
  .screen.landing:has(.hero-grid) .art-main {
    left: 22px;
    width: 82%;
    min-height: 300px;
    padding: 27px 24px;
  }
  .screen.landing:has(.hero-grid) .art-main h3 { font-size: 24px; }
  .screen.landing:has(.hero-grid) .path-circle {
    width: 74px;
    height: 74px;
  }
  .screen.landing:has(.hero-grid) .feature-strip {
    padding-right: 4vw;
    padding-left: 4vw;
  }
  .screen.landing:has(.hero-grid) .feature { gap: 15px; padding: 4px 18px; }
  .screen.landing:has(.hero-grid) .feature-icon { width: 62px; height: 62px; }
  .screen.landing:has(.hero-grid) .feature h3 { font-size: 16px; }
  .screen.landing:has(.hero-grid) .feature p { font-size: 14px; }
}
@media (max-width: 700px) {
  .screen.landing:has(.hero-grid) .landing-nav {
    min-height: 70px;
    padding: 10px 16px;
  }
  .screen.landing:has(.hero-grid) .landing-nav .brand {
    gap: 8px;
    font-size: 19px;
  }
  .screen.landing:has(.hero-grid) .landing-nav .brand-mark {
    width: 37px;
    height: 37px;
    font-size: 23px;
  }
  .screen.landing:has(.hero-grid) .nav-actions { gap: 10px; }
  .screen.landing:has(.hero-grid) .landing-nav .text-btn { font-size: 12px; }
  .screen.landing:has(.hero-grid) .landing-nav .primary-btn {
    min-height: 42px;
    padding: 9px 11px;
    font-size: 12px;
  }
  .screen.landing:has(.hero-grid) .landing-main {
    min-height: 0;
    padding: 38px 20px 22px;
  }
  .screen.landing:has(.hero-grid) .hero-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 5px;
  }
  .screen.landing:has(.hero-grid) .hero .eyebrow {
    font-size: 10px;
    letter-spacing: 1.2px;
  }
  .screen.landing:has(.hero-grid) .hero h1 {
    margin: 15px 0;
    font-size: clamp(42px, 10.6vw, 60px);
    letter-spacing: -1.9px;
    line-height: 1;
  }
  .screen.landing:has(.hero-grid) .hero-copy {
    margin-bottom: 21px;
    font-size: 15px;
  }
  .screen.landing:has(.hero-grid) .hero-actions {
    align-items: stretch;
    flex-direction: column;
    gap: 10px;
  }
  .screen.landing:has(.hero-grid) .hero-actions .primary-btn,
  .screen.landing:has(.hero-grid) .hero-actions .secondary-btn {
    width: 100%;
    min-height: 50px;
    justify-content: center;
    padding: 13px 16px;
    font-size: 14px;
  }
  .screen.landing:has(.hero-grid) .hero-art {
    min-height: 345px;
    max-width: 530px;
    margin: 12px auto 4px;
  }
  .screen.landing:has(.hero-grid) .art-paper { inset: 55px 8px 11px 22px; }
  .screen.landing:has(.hero-grid) .art-main {
    top: 22px;
    left: 0;
    width: 88%;
    min-height: 265px;
    padding: 23px;
  }
  .screen.landing:has(.hero-grid) .art-main h3 {
    margin: 18px 0;
    font-size: 22px;
  }
  .screen.landing:has(.hero-grid) .path-circle {
    top: 5px;
    right: 7%;
    width: 58px;
    height: 58px;
  }
  .screen.landing:has(.hero-grid) .path-circle svg { width: 31px; height: 31px; }
  .screen.landing:has(.hero-grid) .art-mini {
    right: 0;
    bottom: 1px;
    width: min(245px, 58%);
    padding: 15px 17px;
  }
  .screen.landing:has(.hero-grid) .feature-strip {
    min-height: 0;
    grid-template-columns: minmax(0, 1fr);
    padding: 12px 20px 20px;
    border-radius: 20px 20px 0 0;
  }
  .screen.landing:has(.hero-grid) .feature,
  .screen.landing:has(.hero-grid) .feature:first-child,
  .screen.landing:has(.hero-grid) .feature:last-child {
    min-height: 0;
    gap: 17px;
    padding: 16px 2px;
    border: 0;
    border-bottom: 1px solid #DFE2F0;
  }
  .screen.landing:has(.hero-grid) .feature:last-child { border-bottom: 0; }
  .screen.landing:has(.hero-grid) .feature-icon {
    width: 58px;
    height: 58px;
    flex: 0 0 58px;
    border-radius: 14px;
  }
  .screen.landing:has(.hero-grid) .feature-icon svg { width: 29px; height: 29px; }
  .screen.landing:has(.hero-grid) .feature h3 { font-size: 16px; }
  .screen.landing:has(.hero-grid) .feature p { font-size: 14px; }
}
@media (max-width: 360px) {
  .screen.landing:has(.hero-grid) .landing-nav { padding-right: 10px; padding-left: 10px; }
  .screen.landing:has(.hero-grid) .landing-nav .brand { gap: 5px; font-size: 16px; }
  .screen.landing:has(.hero-grid) .landing-nav .brand-mark {
    width: 34px;
    height: 34px;
    font-size: 21px;
  }
  .screen.landing:has(.hero-grid) .nav-actions { gap: 4px; }
  .screen.landing:has(.hero-grid) .landing-nav .text-btn { font-size: 11px; white-space: nowrap; }
  .screen.landing:has(.hero-grid) .landing-nav .primary-btn {
    padding: 8px 5px;
    font-size: 11px;
    white-space: nowrap;
  }
  .screen.landing:has(.hero-grid) .hero h1 {
    font-size: clamp(32px, 10.2vw, 36px);
    letter-spacing: -1.5px;
  }
}
@media (min-width: 701px) and (max-width: 850px) {
  .screen.landing:has(.hero-grid) .hero-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }
  .screen.landing:has(.hero-grid) .hero {
    transform: none;
  }
  .screen.landing:has(.hero-grid) .hero h1 {
    font-size: clamp(54px, 8vw, 66px);
  }
  .screen.landing:has(.hero-grid) .hero-art {
    width: min(100%, 560px);
    min-height: 370px;
    margin: 0 auto;
  }
}
@media (max-width: 700px) {
  .screen.landing:has(.hero-grid) .hero {
    transform: none;
  }
}

.brand-mark,
.screen.landing:has(.hero-grid) .landing-nav .brand-mark,
.auth-side .brand-mark,
.sidebar .brand-mark {
  width: 34px;
  height: 34px;
  min-width: 34px;
  min-height: 34px;
  max-width: 34px;
  max-height: 34px;
  flex: 0 0 34px;
  display: grid;
  place-items: center;
}

/* Shared authenticated navigation and pastel card refresh */
:root {
  --ink: #17213a;
  --muted: #64748b;
  --paper: #f7f9ff;
  --line: #e2e8f4;
  --brand-blue: #4361ee;
  --brand-purple: #7c3aed;
  --shared-card-shadow: 0 8px 22px rgba(67, 82, 145, .09);
}

body {
  color: var(--ink);
  background: linear-gradient(135deg, #f7faff, #fbf9ff);
}

.app-shell {
  display: block;
  min-height: 100vh;
  background: transparent;
}

.app-topnav {
  position: sticky;
  z-index: 20;
  top: 0;
  border-bottom: 1px solid rgba(126, 145, 190, .16);
  background: rgba(250, 251, 255, .94);
  box-shadow: 0 4px 18px rgba(74, 91, 145, .08);
  backdrop-filter: blur(16px);
}

.topnav-inner {
  display: grid;
  width: min(100%, 1480px);
  min-height: 72px;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: clamp(14px, 2.2vw, 32px);
  margin: 0 auto;
  padding: 0 clamp(20px, 4.7vw, 66px);
}

.topnav-brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #17213a;
  font: 700 20px 'Space Grotesk', sans-serif;
  letter-spacing: -.5px;
  white-space: nowrap;
}

.topnav-brand .brand-mark {
  width: 40px;
  height: 40px;
  min-width: 40px;
  min-height: 40px;
  max-width: 40px;
  max-height: 40px;
  border-radius: 11px;
  background: linear-gradient(135deg, #4361ee, #7c3aed);
}

.app-topnav .nav-list {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  gap: clamp(2px, .7vw, 10px);
}

.app-topnav .nav-item {
  display: inline-flex;
  min-height: 42px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 9px clamp(8px, 1.1vw, 15px);
  border: 0;
  border-radius: 11px;
  background: transparent;
  color: #33415f;
  font-size: 13px;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  transition: color .2s ease, background-color .2s ease;
}

.app-topnav .nav-item svg {
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
  color: #53627f;
  stroke-width: 1.8;
}

.app-topnav .nav-item:hover {
  background: rgba(232, 230, 255, .65);
  color: #5942d6;
}

.app-topnav .nav-item.active {
  background: #edeaff;
  color: #553bd4;
  box-shadow: inset 0 0 0 1px rgba(116, 95, 231, .07);
}

.app-topnav .nav-item.active svg { color: #6249e2; }

.topnav-actions { display: flex; justify-content: flex-end; }

.topnav-logout {
  display: inline-flex;
  min-height: 42px;
  align-items: center;
  gap: 9px;
  padding: 8px 10px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: #33415f;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
}

.topnav-logout:hover { background: #f0efff; color: #553bd4; }
.topnav-logout svg { width: 18px; height: 18px; }
.app-topnav .mobile-menu { display: none; }

.main-content {
  width: 100%;
  max-width: 1480px;
  min-width: 0;
  margin: 0 auto;
  padding: 34px clamp(22px, 4.7vw, 66px) 56px;
  background: transparent;
}

.main-content:has(.explorer-page),
.main-content:has(.course-match-page) {
  background: transparent;
}

.view-heading { margin-bottom: 28px; }
.view-heading h1 { color: #17213a; }
.view-heading p { color: #64748b; }
.standard-page-title { font-family: 'DM Sans', sans-serif; }

.category-card,
.main-content .course-card,
.main-content:not(:has(.explorer-page)) .stat-card,
.main-content:not(:has(.explorer-page)) .profile-card,
.main-content:not(:has(.explorer-page)) .detail-hero,
.main-content:not(:has(.explorer-page)) .detail-panel,
.main-content:not(:has(.explorer-page)) .admin-stat,
.main-content:not(:has(.explorer-page)) .admin-chart,
.main-content:not(:has(.explorer-page)) .admin-registration-list > div,
.main-content:not(:has(.explorer-page)) .activity-stats > div,
.main-content:not(:has(.explorer-page)) .saved-session,
.main-content:not(:has(.explorer-page)) .course-match-summary,
.main-content:not(:has(.explorer-page)) .course-match-results > .result-head,
.main-content:not(:has(.explorer-page)) .course-match-explanations article,
.main-content:not(:has(.explorer-page)) .result-card,
.main-content:not(:has(.explorer-page)) .quiz-box:not(.course-match-results-chat),
.main-content:not(:has(.explorer-page)) .about-point {
  border: 1px solid rgba(126, 145, 190, .16);
  border-top: 1px solid rgba(126, 145, 190, .16);
  border-radius: 18px;
  box-shadow: var(--shared-card-shadow);
}

.main-content:not(:has(.explorer-page)) .stat-card,
.main-content:not(:has(.explorer-page)) .profile-card,
.main-content:not(:has(.explorer-page)) .detail-hero,
.main-content:not(:has(.explorer-page)) .detail-panel,
.main-content:not(:has(.explorer-page)) .admin-stat,
.main-content:not(:has(.explorer-page)) .admin-chart,
.main-content:not(:has(.explorer-page)) .admin-registration-list > div,
.main-content:not(:has(.explorer-page)) .activity-stats > div,
.main-content:not(:has(.explorer-page)) .saved-session,
.main-content:not(:has(.explorer-page)) .course-match-summary,
.main-content:not(:has(.explorer-page)) .course-match-results > .result-head,
.main-content:not(:has(.explorer-page)) .course-match-explanations article,
.main-content:not(:has(.explorer-page)) .result-card,
.main-content:not(:has(.explorer-page)) .quiz-box:not(.course-match-results-chat),
.main-content:not(:has(.explorer-page)) .about-point {
  border-left: 1px solid rgba(126, 145, 190, .16);
  border-right: 1px solid rgba(126, 145, 190, .16);
  border-bottom: 1px solid rgba(126, 145, 190, .16);
  background: linear-gradient(145deg, var(--card-pastel, #f2f5ff) 0%, #fff 96%);
}

.main-content:not(:has(.explorer-page)) .stat-card {
  --card-pastel: #eaf3ff;
  border-radius: 18px;
}

.main-content:not(:has(.explorer-page)) .stat-card:nth-child(3n + 2),
.main-content:not(:has(.explorer-page)) .profile-card:nth-child(3n + 2),
.main-content:not(:has(.explorer-page)) .admin-stat:nth-child(4n + 2),
.main-content:not(:has(.explorer-page)) .admin-chart:nth-child(3n + 2) { --card-pastel: #f0edff; }

.main-content:not(:has(.explorer-page)) .stat-card:nth-child(3n),
.main-content:not(:has(.explorer-page)) .profile-card:nth-child(3n),
.main-content:not(:has(.explorer-page)) .admin-stat:nth-child(4n + 3) { --card-pastel: #fff0f6; }

.main-content:not(:has(.explorer-page)) .admin-stat:nth-child(4n) { --card-pastel: #e9f6f0; }
.main-content:not(:has(.explorer-page)) .profile-card { padding: 22px; }
.main-content:not(:has(.explorer-page)) .admin-stat { border-radius: 16px; }
.main-content:not(:has(.explorer-page)) .admin-stat > span { background: rgba(255,255,255,.72); }
.main-content:not(:has(.explorer-page)) .activity-stats > div { --card-pastel: #eaf3ff; border-radius: 13px; }
.main-content:not(:has(.explorer-page)) .activity-stats > div:nth-child(2) { --card-pastel: #f0edff; }
.main-content:not(:has(.explorer-page)) .activity-stats > div:nth-child(3) { --card-pastel: #fff0f6; }
.main-content:not(:has(.explorer-page)) .saved-session { --card-pastel: #f1edff; border-radius: 14px; }

.main-content .course-card {
  --card-pastel: #e3f0ff;
  min-width: 0;
  min-height: 238px;
  height: 100%;
  overflow: hidden;
  border-radius: 18px;
  background: linear-gradient(145deg, var(--card-pastel) 0%, #f8fbff 100%);
  cursor: pointer;
  transition: transform .2s ease, box-shadow .2s ease;
}

.main-content:not(:has(.explorer-page)) .course-card {
  border-radius: 18px;
  border-top: 1px solid rgba(126, 145, 190, .16);
  background: linear-gradient(145deg, var(--card-pastel, #e3f0ff) 0%, #f8fbff 100%);
}

.main-content:not(:has(.explorer-page)) .course-card[data-category="technology-computing"] { --card-pastel: #e3f0ff; }
.main-content:not(:has(.explorer-page)) .course-card[data-category="business-management"] { --card-pastel: #fff0dc; }
.main-content:not(:has(.explorer-page)) .course-card[data-category="engineering-architecture"] { --card-pastel: #eee7ff; }
.main-content:not(:has(.explorer-page)) .course-card[data-category="health-medical"] { --card-pastel: #ffe5f0; }
.main-content:not(:has(.explorer-page)) .course-card[data-category="education"] { --card-pastel: #e2f1e9; }
.main-content:not(:has(.explorer-page)) .course-card[data-category="arts-design-communication"] { --card-pastel: #ffe3ed; }
.main-content:not(:has(.explorer-page)) .course-card[data-category="science-environment"] { --card-pastel: #e0f3f1; }
.main-content:not(:has(.explorer-page)) .course-card[data-category="social-public-service"] { --card-pastel: #e7e9ff; }

.main-content .course-card[data-category="technology-computing"] { --card-pastel: #e3f0ff; }
.main-content .course-card[data-category="business-management"] { --card-pastel: #fff0dc; }
.main-content .course-card[data-category="engineering-architecture"] { --card-pastel: #eee7ff; }
.main-content .course-card[data-category="health-medical"] { --card-pastel: #ffe5f0; }
.main-content .course-card[data-category="education"] { --card-pastel: #e2f1e9; }
.main-content .course-card[data-category="arts-design-communication"] { --card-pastel: #ffe3ed; }
.main-content .course-card[data-category="science-environment"] { --card-pastel: #e0f3f1; }
.main-content .course-card[data-category="social-public-service"] { --card-pastel: #e7e9ff; }

.main-content .course-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 13px 28px rgba(67, 82, 145, .14);
}

.main-content .course-card .course-color { display: none; }
.main-content .course-card .course-card-body {
  display: flex;
  min-height: 236px;
  flex-direction: column;
  padding: 21px;
}

.main-content .course-card h3 {
  color: #17213a;
  font-family: 'DM Sans', sans-serif;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -.3px;
  line-height: 1.35;
}

.main-content .course-card p {
  min-height: 42px;
  color: #64748b;
  font-size: 14px;
  line-height: 1.55;
}

.main-content .course-card .card-foot {
  gap: 10px;
  margin-top: auto;
  border-top-color: rgba(126, 145, 190, .15);
}

.main-content .course-card .pill {
  padding: 5px 9px;
  border: 1px solid rgba(94, 115, 160, .1);
  border-radius: 999px;
  background: rgba(255,255,255,.65);
  color: #465574;
  font-size: 11px;
}

.course-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
.course-grid > .empty { grid-column: 1 / -1; }

.category-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.category-card {
  --category-start: #e3f0ff;
  --category-end: #f8fbff;
  --category-accent: #3976d8;
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 236px;
  flex-direction: column;
  justify-content: space-between;
  gap: 12px;
  overflow: hidden;
  padding: 20px;
  border: 1px solid rgba(126, 145, 190, .14);
  border-radius: 18px;
  background: linear-gradient(145deg, var(--category-start), var(--category-end));
  box-shadow: 0 7px 17px rgba(74, 91, 145, .10);
  color: #17213a;
  text-align: left;
  cursor: pointer;
  transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
}

.category-card::before,
.category-card::after {
  position: absolute;
  z-index: 0;
  content: "";
  pointer-events: none;
}

.category-card::before {
  right: -42px;
  bottom: 17px;
  width: 190px;
  height: 75px;
  border-radius: 50%;
  background: rgba(255,255,255,.26);
  transform: rotate(-24deg);
}

.category-card::after {
  top: -40px;
  right: -18px;
  width: 160px;
  height: 125px;
  border-radius: 48% 52% 56% 44%;
  background: rgba(255,255,255,.28);
}

.category-card[data-category="technology-computing"] { --category-start: #e3f0ff; --category-end: #f8fbff; --category-accent: #3478dc; }
.category-card[data-category="business-management"] { --category-start: #fff0dc; --category-end: #fffbf6; --category-accent: #d97732; }
.category-card[data-category="engineering-architecture"] { --category-start: #eee7ff; --category-end: #faf8ff; --category-accent: #7550d9; }
.category-card[data-category="health-medical"] { --category-start: #ffe5f0; --category-end: #fff8fb; --category-accent: #d54e91; }
.category-card[data-category="education"] { --category-start: #e2f1e9; --category-end: #f8fcfa; --category-accent: #39836a; }
.category-card[data-category="arts-design-communication"] { --category-start: #ffe3ed; --category-end: #fff8fb; --category-accent: #ca4e8d; }
.category-card[data-category="science-environment"] { --category-start: #e0f3f1; --category-end: #f7fcfb; --category-accent: #328d87; }
.category-card[data-category="social-public-service"] { --category-start: #e7e9ff; --category-end: #f9f9ff; --category-accent: #566bc3; }

.explorer-page .category-card {
  border: 1px solid rgba(126, 145, 190, .16);
  border-radius: 18px;
}

.category-card:hover {
  transform: translateY(-3px);
  border-color: rgba(110, 125, 170, .24);
  box-shadow: 0 13px 28px rgba(67, 82, 145, .15);
}

.category-card-copy {
  position: relative;
  z-index: 2;
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 7px;
  margin-top: 10px;
}

.category-card-art {
  position: absolute;
  z-index: 1;
  top: 10px;
  right: 10px;
  width: 52%;
  max-width: 148px;
  height: auto;
  object-fit: contain;
  object-position: right top;
  pointer-events: none;
}

.category-card-copy strong {
  color: #101b3c;
  max-width: 68%;
  font: 700 18px/1.25 'DM Sans', sans-serif;
  letter-spacing: -.3px;
}

.explorer-page .category-card .category-card-copy > strong {
  font-size: 18px;
  font-weight: 700;
  line-height: 1.25;
}

.category-card-copy > span {
  width: 100%;
  color: #475569;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.5;
}

.category-card-footer {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: auto;
}

.category-card-footer small {
  padding: 7px 11px;
  border-radius: 999px;
  background: rgba(255,255,255,.58);
  color: var(--category-accent);
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
}

.explorer-page .category-card .category-card-footer small {
  padding: 7px 11px;
  border-radius: 999px;
  background: rgba(255,255,255,.58);
  color: var(--category-accent);
  font-size: 13px;
  font-weight: 600;
}

.category-card-action {
  gap: 4px;
  color: #563bff;
  font-size: 14px;
  font-weight: 600;
  white-space: nowrap;
}

.explorer-page .course-view-options { margin: 18px 0 20px; }
.explorer-page .course-view-option.active {
  background: linear-gradient(110deg, #4361ee, #7c3aed);
  color: #fff;
}
.explorer-page .search-box,
.explorer-page .filter-select { border-radius: 11px; }

.main-content:not(:has(.explorer-page)) .quiz-box:not(.course-match-results-chat) { padding: 24px; }
.main-content:not(:has(.explorer-page)) .answer {
  border: 1px solid rgba(126, 145, 190, .18);
  border-radius: 14px;
  background: linear-gradient(145deg, #eef4ff, #fff);
  color: #273653;
  transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
}
.main-content:not(:has(.explorer-page)) .answer:hover {
  transform: translateY(-2px);
  border-color: rgba(99, 82, 216, .3);
  box-shadow: 0 7px 16px rgba(67, 82, 145, .08);
}
.main-content:not(:has(.explorer-page)) .answer.selected {
  border-color: #7967df;
  background: linear-gradient(145deg, #eeebff, #f9f7ff);
}
.main-content:not(:has(.explorer-page)) .quiz-progress span { border-radius: 999px; }

.course-match-page .result-card.course-match-result-card {
  border: 1px solid rgba(126, 145, 190, .16);
  border-radius: 18px;
  background: linear-gradient(145deg, var(--card-pastel, #e3f0ff), #fff 96%);
  box-shadow: var(--shared-card-shadow);
}
.course-match-page .result-card.course-match-result-card[data-category="technology-computing"] { --card-pastel: #e3f0ff; }
.course-match-page .result-card.course-match-result-card[data-category="business-management"] { --card-pastel: #fff0dc; }
.course-match-page .result-card.course-match-result-card[data-category="engineering-architecture"] { --card-pastel: #eee7ff; }
.course-match-page .result-card.course-match-result-card[data-category="health-medical"] { --card-pastel: #ffe5f0; }
.course-match-page .result-card.course-match-result-card[data-category="education"] { --card-pastel: #e2f1e9; }
.course-match-page .result-card.course-match-result-card[data-category="arts-design-communication"] { --card-pastel: #ffe3ed; }
.course-match-page .result-card.course-match-result-card[data-category="science-environment"] { --card-pastel: #e0f3f1; }
.course-match-page .result-card.course-match-result-card[data-category="social-public-service"] { --card-pastel: #e7e9ff; }
.course-match-page .result-card.course-match-result-card:first-child {
  border-width: 1px;
  padding: 28px;
  background: linear-gradient(145deg, var(--card-pastel, #e3f0ff), #fff 96%);
  box-shadow: 0 12px 28px rgba(67, 82, 145, .12);
}
.course-match-page .result-course-heading .category,
.course-match-page .recommendation-rank { color: #5846c7; }
.course-match-page .course-match-results > .result-head,
.course-match-page .results-chat-heading {
  border-radius: 18px;
  background: linear-gradient(135deg, #eaf2ff, #f2edff 58%, #fff1f7);
}
.course-match-page .course-match-explanations article {
  border-left: 1px solid rgba(126, 145, 190, .16);
  background: linear-gradient(135deg, #f0edff, #fff);
}
.course-match-page .result-course-details > div {
  border-radius: 12px;
  background: rgba(255,255,255,.75);
}

.main-content:not(:has(.explorer-page)) .about-point {
  min-height: 100%;
  border-radius: 16px;
  background: linear-gradient(145deg, #eaf2ff, #fff);
}

.main-content:not(:has(.explorer-page)) .admin-inline-form,
.main-content:not(:has(.explorer-page)) .admin-course-form,
.main-content:not(:has(.explorer-page)) .admin-settings-form {
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(255,255,255,.9);
  box-shadow: none;
}

.admin-users-table th { background: #f2f3ff; }
.admin-users-table tbody tr:nth-child(even) { background: rgba(255,255,255,.55); }

@media (max-width: 1100px) {
  .category-grid,
  .course-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 1020px) {
  .topnav-inner { gap: 12px; padding-right: 22px; padding-left: 22px; }
  .app-topnav .nav-list { gap: 0; }
  .app-topnav .nav-item { gap: 6px; padding-right: 8px; padding-left: 8px; font-size: 12px; }
  .app-topnav .nav-item svg { width: 16px; height: 16px; flex-basis: 16px; }
}

@media (max-width: 850px) {
  .topnav-inner {
    position: relative;
    min-height: 68px;
    grid-template-columns: auto 1fr auto;
  }
  .app-topnav .mobile-menu {
    display: inline-grid;
    width: 42px;
    height: 42px;
    place-items: center;
    grid-column: 3;
    grid-row: 1;
    border: 1px solid rgba(126, 145, 190, .18);
    border-radius: 11px;
    background: rgba(255,255,255,.75);
    color: #33415f;
  }
  .app-topnav .nav-list {
    position: absolute;
    top: calc(100% - 1px);
    right: 16px;
    left: 16px;
    display: none;
    align-items: stretch;
    gap: 4px;
    padding: 10px;
    border: 1px solid rgba(126, 145, 190, .18);
    border-radius: 0 0 16px 16px;
    background: rgba(250, 251, 255, .98);
    box-shadow: 0 14px 24px rgba(67, 82, 145, .12);
  }
  .app-topnav .nav-list.open { display: grid; }
  .app-topnav .nav-item { justify-content: flex-start; padding: 11px 13px; font-size: 14px; text-align: left; }
  .app-topnav .nav-item svg { width: 18px; height: 18px; flex-basis: 18px; }
  .topnav-actions { grid-column: 2; grid-row: 1; justify-self: end; margin-right: 52px; }
  .topnav-logout { min-height: 40px; }
  .main-content { padding-top: 28px; }
  .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .course-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 600px) {
  .topnav-inner { min-height: 64px; padding-right: 16px; padding-left: 16px; }
  .topnav-brand { gap: 8px; font-size: 18px; }
  .topnav-brand .brand-mark { width: 36px; height: 36px; min-width: 36px; min-height: 36px; }
  .topnav-actions { margin-right: 46px; }
  .topnav-logout { gap: 6px; padding: 7px; font-size: 12px; }
  .topnav-logout svg { width: 17px; height: 17px; }
  .topnav-logout span { display: none; }
  .main-content { padding: 24px 16px 40px; }
  .view-heading { align-items: flex-start; margin-bottom: 22px; }
  .view-heading h1 { font-size: clamp(30px, 9vw, 38px); }
  .category-grid,
  .course-grid { grid-template-columns: 1fr; gap: 14px; }
  .category-card { min-height: 236px; padding: 20px; }
  .category-card-art { width: 52%; max-width: 148px; }
  .category-card-copy { width: 100%; margin-top: 10px; }
  .main-content .course-card { min-height: 0; }
  .main-content .course-card .course-card-body { min-height: 220px; padding: 19px; }
  .main-content:not(:has(.explorer-page)) .profile-card { padding: 18px; }
  .main-content:not(:has(.explorer-page)) .quiz-box:not(.course-match-results-chat) { padding: 19px; }
  .course-match-page .result-card.course-match-result-card:first-child { padding: 20px; }
  .explorer-page .course-view-options { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
  .app-topnav .nav-item,
  .category-card,
  .main-content .course-card,
  .main-content:not(:has(.explorer-page)) .answer {
    transition: none;
  }
  .category-card:hover,
  .main-content .course-card:hover,
  .main-content:not(:has(.explorer-page)) .answer:hover { transform: none; }
  background: linear-gradient(135deg, #3068FF, #7C3AED);
  border-radius: 9px;
  color: #fff;
  font-family: 'DM Sans', sans-serif;
  font-size: 22px;
  font-weight: 700;
  line-height: 1;
}
.brand,
.screen.landing:has(.hero-grid) .landing-nav .brand {
  gap: 10px;
  color: #fff;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: normal;
}
.maintenance-page .brand {
  width: fit-content;
  padding: 10px 14px;
  border-radius: 12px;
  background: #112748;
  color: #fff;
}

.app-topnav .topnav-brand { color: #17213a; }

.app-shell:has(.explorer-page) .app-topnav .nav-item.active,
.app-shell:has(.course-match-page) .app-topnav .nav-item.active {
  background: #edeaff;
  color: #553bd4;
  box-shadow: inset 0 0 0 1px rgba(116, 95, 231, .07);
}

.app-shell:has(.explorer-page) .app-topnav .nav-item.active svg,
.app-shell:has(.course-match-page) .app-topnav .nav-item.active svg { color: #6249e2; }
