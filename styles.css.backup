.main-content:not(:has(.explorer-page)) .result-card {
  --card-accent: var(--brand-purple);
  --card-pastel: #F6F2FF;
}
.main-content:not(:has(.explorer-page)) .result-card[data-category="technology-computing"] { --card-accent: var(--category-blue); --card-pastel: var(--category-blue-pastel); }
.main-content:not(:has(.explorer-page)) .result-card[data-category="business-management"] { --card-accent: var(--category-orange); --card-pastel: var(--category-orange-pastel); }
